#!/usr/bin/env bash
# lanes-guard <lead-only|plan-message|main-edit>: PreToolUse hook guards for a lead and its lanes.
#   lead-only     Bash: refuse a command whose text names a lead-only pattern (CI dispatch, merge, push), unless from
#                 the lead or a full parse proves each mention is data or the one allowed push form.
#   plan-message  SendMessage: refuse a message that starts with the plan marker unless the caller is the lead.
#   main-edit     Edit, Write, NotebookEdit: refuse a path inside the main checkout while linked worktrees exist.
# Reads the hook JSON on stdin. A refusal is the PreToolUse decision JSON on stdout (code.claude.com/docs/en/hooks,
# "PreToolUse decision control": hookSpecificOutput.permissionDecision "deny" plus permissionDecisionReason) and exit 0.
# Silence with exit 0 hands the call to the normal permission flow. This is a mistake guard, not a security boundary:
# it fails open on unreadable input or a missing jq, except for a command that still names a lead-only pattern.
[ "${BASH_VERSINFO[0]}" -ge 4 ] || { echo "${0##*/}: requires Bash 4 or newer: on macOS run 'brew install bash'" >&2; exit 2; }
set -euo pipefail
export LC_ALL=C

DATA="${LANES_DATA_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/lanes}"
DEFAULT_PATTERNS='gh workflow run; gh pr merge; git push @default'
# Environment variables that change which git config a push reads (HOME and XDG_CONFIG_HOME move the global file).
GIT_CONFIG_ENV='(GIT_CONFIG_[A-Z0-9_]+|HOME|XDG_CONFIG_HOME)'

# shellcheck source-path=SCRIPTDIR source=../lib/tokenize.bash
. "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/tokenize.bash"

note() { echo "lanes-guard: $*" >&2; }

# deny <reason>: print the PreToolUse deny decision and stop.
deny() {
  jq -n --arg r "$1" '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}'
  exit 0
}

# ---- input and config --------------------------------------------------------------------------------------------

# jstr <dotted path>: a string field of the hook input, or nothing.
jstr() { jq -r --arg p "$1" 'try (getpath($p | split(".")) | strings) catch empty' <<<"$INPUT" 2>/dev/null || true; }

# find_config: the first .lanes/guards.md in the project dir, then from the session directory upward.
find_config() {
  local d
  CONFIG_FILE=""
  for d in "${CLAUDE_PROJECT_DIR:-}" "$CWD"; do
    while [ -n "$d" ] && [ "$d" != "/" ]; do
      if [ -f "$d/.lanes/guards.md" ]; then CONFIG_FILE="$d/.lanes/guards.md"; return 0; fi
      [ "$d" = "${CLAUDE_PROJECT_DIR:-}" ] && break
      d="$(dirname "$d")"
    done
  done
}

# setting <key> <default>: guards.md "key: value" line, else the userConfig env CLAUDE_PLUGIN_OPTION_<KEY>, else the default.
setting() {
  local key="$1" v="" envname
  if [ -n "$CONFIG_FILE" ]; then
    v="$(sed -n "s/^[[:space:]]*$key:[[:space:]]*//p" "$CONFIG_FILE" | tail -n 1)"
    v="${v%"${v##*[![:space:]]}"}"
  fi
  if [ -z "$v" ]; then
    envname="CLAUDE_PLUGIN_OPTION_$(printf '%s' "$key" | tr '[:lower:]' '[:upper:]')"
    v="${!envname:-}"
  fi
  printf '%s' "${v:-$2}"
}

# lookup_caller: sets ROLE (lead, lane, other role, none) and CALLER_LANE from the session index and the registry.
# PreToolUse input carries no session_title, so the session id is the key: $DATA/sessions/<id> names the lane, which
# `lanes register` rewrites on every SessionStart (docs/CONVENTIONS.md "State").
lookup_caller() {
  local lane="" safe='^[A-Za-z0-9][A-Za-z0-9._-]*$' f
  ROLE="none"
  CALLER_LANE=""
  if [[ "$SID" =~ $safe ]] && [ -f "$DATA/sessions/$SID" ]; then IFS= read -r lane <"$DATA/sessions/$SID" || true; fi
  [[ "$lane" =~ $safe ]] || return 0
  f="$DATA/lanes/$lane.json"
  [ -f "$f" ] || return 0
  CALLER_LANE="$lane"
  if ! ROLE="$(jq -er '.role | strings' "$f" 2>/dev/null)"; then
    note "registry file $f is unreadable or has no role: treating the session as unregistered"
    ROLE="none"
  fi
}

# refuse_not_lead <rule> <what was refused> <allowed path>: the denial for a caller that is not the lead.
refuse_not_lead() {
  case "$ROLE" in
    none) deny "lanes-guards rule $1: $2. This session is not in the lanes registry ($DATA/lanes), so the guard cannot tell whether it is the lead. Launch it as \`claude --name <lane>\` and run \`lanes register\` (lanes core plugin). Allowed path: $3" ;;
    *) deny "lanes-guards rule $1: $2. This session is lane \"$CALLER_LANE\" (role $ROLE), not the lead. Allowed path: $3" ;;
  esac
}

# ---- mentions ----------------------------------------------------------------------------------------------------
# A command is refused when its text holds every word of a lead-only pattern, in any order and anywhere. Only a full
# parse can lift that (exempt), so a word the parser loses or misreads costs a false refusal; only its short list of
# data rules can let a mention through.

declare -A CNT=() PWORDS=() DATA_SUB=() SUB_BAD=()
PATTERNS=(); PAT_WORDS=()

# load_patterns: PATTERNS from the setting, split on ";", with each pattern's words as the mention check reads them.
load_patterns() {
  local raw p w x
  local -a ws
  raw="$(setting lead_only_commands "$DEFAULT_PATTERNS")"
  while IFS= read -r p; do
    p="${p#"${p%%[![:space:]]*}"}"; p="${p%"${p##*[![:space:]]}"}"
    w="${p,,}"; w="${w//@default/ }"; w="${w//[^a-z0-9_-]/ }"
    read -ra ws <<<"$w"
    [ "${#ws[@]}" -gt 0 ] || continue
    PATTERNS+=("$p"); PAT_WORDS+=("${ws[*]}")
    for x in "${ws[@]}"; do PWORDS[$x]=1; done
  done <<<"${raw//;/$'\n'}"
  return 0
}

# decode_ansi <text>: sets REPLY to text with each $'...' decoded as bash decodes it. The scan stops only at an
# unescaped quote, so eval sees one $'...' word, which expands nothing; an unterminated one stays as it is.
decode_ansi() {
  local s="$1" out="" body j n
  while [[ "$s" == *"\$'"* ]]; do
    out+="${s%%"\$'"*}"; s="${s#*"\$'"}"
    j=0; n=${#s}
    while [ "$j" -lt "$n" ] && [ "${s:j:1}" != "'" ]; do
      if [ "${s:j:1}" = "\\" ]; then j=$((j + 1)); fi
      j=$((j + 1))
    done
    if [ "$j" -ge "$n" ]; then out+="\$'"; break; fi
    body="${s:0:j}"; eval "body=\$'$body'"
    out+="$body"; s="${s:j+1}"
  done
  REPLY="$out$s"
}

# count_tokens <kind> <text>: adds the pattern words in text to CNT[<kind>:<word>]. The text is read as a shell may:
# $'...' decoded, line continuations joined, lowercased, quotes dropped (`g""h`), and read twice, once with backslashes
# dropped (`g\h`) and once with each escape as a break (`printf 'x\ngh'`). A hyphen inside a word is a break too
# (`gh-pr-merge.sh`), and a short-option token ending in a pattern word counts as that word (`-S'gh pr'`).
count_tokens() {
  local t w p
  local -a parts
  decode_ansi "$2"
  t="${REPLY//$'\\\n'/}"; t="${t,,}"
  t=${t//[\"\']/}
  t="${t//\\/} ${t//\\?/ }"
  read -ra parts <<<"${t//[^a-z0-9_-]/ }"
  for w in "${parts[@]}"; do
    if [[ "$w" != -* && "$w" == *-* ]]; then count_tokens "$1" "${w//-/ }"; continue; fi
    if [[ "$w" == -[!-]* && -z "${PWORDS[$w]+x}" ]]; then
      for p in "${!PWORDS[@]}"; do if [[ "$w" == *"$p" ]]; then w="$p"; break; fi; done
    fi
    [ -z "${PWORDS[$w]+x}" ] || CNT[$1:$w]=$((${CNT[$1:$w]:-0} + 1))
  done
}

# mentions <raw|pool>: sets MATCHED to the first pattern with every word in the raw text, or in what is left of it
# once proven data is taken out (pool).
mentions() {
  local i w n
  local -a ws
  for ((i = 0; i < ${#PATTERNS[@]}; i++)); do
    read -ra ws <<<"${PAT_WORDS[i]}"
    for w in "${ws[@]}"; do
      n=${CNT[raw:$w]:-0}
      [ "$1" = raw ] || n=$((n - ${CNT[data:$w]:-0}))
      [ "$n" -gt 0 ] || continue 2
    done
    MATCHED="${PATTERNS[i]}"; return 0
  done
  return 1
}

# ---- exemptions --------------------------------------------------------------------------------------------------

# default_branches <git dir> <remote>: the branch names a push to that remote must not target, one per line: the
# default_branch setting and the remote's head (refs/remotes/<remote>/HEAD). Nothing when neither is known.
default_branches() {
  local configured head
  configured="$(setting default_branch "")"
  head="$(git -C "$1" symbolic-ref --short -q "refs/remotes/$2/HEAD" 2>/dev/null || true)"
  [ -z "$configured" ] || echo "$configured"
  [ -z "$head" ] || echo "${head#"$2"/}"
}

# not_default <branch> <default list>: true when the branch is not in the list.
not_default() { ! grep -Fxq -- "$1" <<<"$2"; }

# branch_name <ref>: the branch a refspec side names, or nothing for HEAD-like names, refs outside refs/heads/, and
# words with a glob, brace, expansion or revision character. Those depend on the checkout or the shell, so are refused.
branch_name() {
  local name="${1#refs/heads/}" up
  up="${name^^}"
  [[ "$name" != refs/* && "$name" != @ && "$up" != HEAD && "$up" != *_HEAD ]] || return 0
  [[ "$name" =~ ^[A-Za-z0-9._/@][A-Za-z0-9._/@+-]*$ ]] || return 0
  printf '%s' "$name"
}

# push_allowed: true for `git [-C <dir>] push [-u|--set-upstream] [--force-with-lease[=...]] <remote> <branch>` with a
# configured <remote> whose default is known and a non-default <branch> or <branch>:<same branch>. Any other push depends
# on the checkout, git config or a pattern, so it is the lead's. The checkout is RUN_DIR (the session directory
# or a leading cd), then -C.
# A plain <branch> is mapped by remote.<r>.push, push.default=upstream and symrefs (git builtin/push.c
# refspec_append_mapped), so it passes only when none of them is set in the target checkout and
# no GIT_CONFIG_ENV assignment is on the line.
push_allowed() {
  local a x dir="$RUN_DIR" seen=0 src dst target defaults
  local -a pos=()
  PUSH_HINT="push explicitly: git push <remote> <your-branch>"
  if [ "$DIR_UNSURE" -eq 1 ]; then
    PUSH_HINT="the guard cannot tell which checkout this push runs in; change directory only with one leading \`cd <absolute path> &&\`, or push with git -C <your-worktree> push <remote> <your-branch>"
    return 1
  fi
  for ((a = 1; a < ${#W[@]}; a++)); do
    x="${W[a]}"
    if [ "$seen" -eq 0 ]; then
      case "$x" in
        push) seen=1 ;;
        -C)
          a=$((a + 1)); x="${W[a]:-}"
          [[ -n "$x" && "$x" != *'$'* ]] || return 1
          case "$x" in /*) dir="$x" ;; *) dir="$dir/$x" ;; esac ;;
        *) return 1 ;;
      esac
      continue
    fi
    case "$x" in
      -u|--set-upstream|--force-with-lease|--force-with-lease=*) ;;
      -*) return 1 ;;
      *) pos+=("$x") ;;
    esac
  done
  [ "${#pos[@]}" -eq 2 ] && [[ "${pos[0]}" =~ ^[A-Za-z0-9._/-]+$ ]] || return 1
  src="${pos[1]%%:*}"; dst="${pos[1]#*:}"
  src="$(branch_name "$src")"; dst="$(branch_name "$dst")"
  [ -n "$src" ] && [ "$src" = "$dst" ] || return 1
  # A URL, a path or an unknown name has no local head to name its default, so only a configured remote passes.
  if [ -z "$(git -C "$dir" config --get "remote.${pos[0]}.url" 2>/dev/null || true)" ]; then
    PUSH_HINT="push to a remote configured in the checkout: git push <remote> <your-branch>"
    return 1
  fi
  defaults="$(default_branches "$dir" "${pos[0]}")"
  if [ -z "$defaults" ]; then
    PUSH_HINT="the default branch of remote ${pos[0]} is unknown: run \`git remote set-head ${pos[0]} --auto\` once, or set default_branch in .lanes/guards.md"
    return 1
  fi
  not_default "$src" "$defaults" || return 1
  target="$(git -C "$dir" symbolic-ref -q "refs/heads/$src" 2>/dev/null || true)"
  if [[ "${pos[1]}" == *:* ]]; then not_default "${target#refs/heads/}" "$defaults"; return; fi
  PUSH_HINT="push explicitly: git push <remote> <name>:<name>"
  [ -z "$target" ] && [ "$GIT_ENV_CONFIG" -eq 0 ] || return 1
  [ -z "$(git -C "$dir" config --get-all "remote.${pos[0]}.push" 2>/dev/null || true)" ] || return 1
  [[ ! "$(git -C "$dir" config push.default 2>/dev/null || true)" =~ ^(upstream|tracking)$ ]]
}

# drop <n>: removes the first n words of W.
drop() { if [ "${#W[@]}" -le "$1" ]; then W=(); else W=("${W[@]:$1}"); fi; }

# split_words <SEP-joined command>: sets W to its words, keeping empty ones.
split_words() {
  local rest="$1$SEP"
  W=()
  while [ -n "$rest" ]; do W+=("${rest%%"$SEP"*}"); rest="${rest#*"$SEP"}"; done
}

# is_assignment <word>
is_assignment() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*\+?= ]]; }

# printer: true when W only prints its words, a file or its stdin: echo, cat, or printf without -v.
printer() { case "${W[0]##*/}" in echo|cat) ;; printf) [[ "${W[1]:-}" != -v* ]] ;; *) false ;; esac; }

# note_changes <index>: for command idx, sets DIR_UNSURE when it may change the checkout or config later pushes read
# (cd, pushd, popd, eval, source, a $ command word, a GIT_DIR assignment, an export of git config), GIT_ENV_CONFIG for
# a git config assignment, FUNC_DEF for a function, and SUB_BAD for a substitution that does more than print.
note_changes() {
  local -a W
  local d
  split_words "${CMDS[$1]}"
  while [ "${#W[@]}" -gt 0 ] && is_assignment "${W[0]}"; do
    if [[ "${W[0]}" =~ ^$GIT_CONFIG_ENV= ]]; then GIT_ENV_CONFIG=1; fi
    if [[ "${W[0]}" =~ ^GIT_(DIR|COMMON_DIR)= ]]; then DIR_UNSURE=1; fi
    drop 1
  done
  [ "${#W[@]}" -gt 0 ] || return 0
  if [ -n "${CMD_SUB[$1]}" ] && { ! printer || [[ "${CMD_RAW[$1]}" == *'>'* || "${CMD_RAW[$1]}" == *'<('* ]]; }; then
    SUB_BAD[${CMD_SUB[$1]}]=1
  fi
  while [[ "${W[0]}" =~ ^(builtin|command|exec|-.*)$ ]] && [ "${#W[@]}" -gt 1 ]; do drop 1; done
  if [[ "${W[0]}" == *'$'* ]]; then DIR_UNSURE=1; fi
  case "${W[0]##*/}" in
    cd|pushd|popd|eval|source|.) DIR_UNSURE=1 ;;
    function) FUNC_DEF=1 ;;
    export|declare|typeset|readonly|local)
      for d in "${W[@]:1}"; do if [[ "$d" =~ ^(GIT_DIR|GIT_COMMON_DIR|$GIT_CONFIG_ENV)= ]]; then DIR_UNSURE=1; fi; done ;;
  esac
}

# data_words <word...>: counts the words as proven data, and marks the substitutions in them as data.
data_words() {
  local w m
  for w in "$@"; do
    count_tokens data "$w"
    while [[ "$w" == *"$SUBMARK"*"$SUBMARK"* ]]; do
      w="${w#*"$SUBMARK"}"; m="${w%%"$SUBMARK"*}"; w="${w#*"$SUBMARK"}"
      DATA_SUB[$m]=1
    done
  done
}

# classify <index>: counts command idx's words and stdin as parsed text, and the part it proves harmless as data: the
# arguments of git commit and gh pr|issue create|comment|edit, grep's and rg's operands, an allowed push, and what a
# printer prints where nothing reads it (on a line with no pipe, redirection or process substitution, or into a
# substitution that is itself data).
classify() {
  local -a W
  local w sub="${CMD_SUB[$1]}" stdin="${CMD_STDIN[$1]:-}" i
  split_words "${CMDS[$1]}"
  for w in "${W[@]}"; do count_tokens parsed "$w"; done
  if [ -n "$stdin" ]; then count_tokens parsed "$stdin"; fi
  while [ "${#W[@]}" -gt 0 ] && is_assignment "${W[0]}"; do drop 1; done
  [ "${#W[@]}" -gt 0 ] || return 0
  case "${W[0]##*/}" in
    git)
      if [ "${W[1]:-}" = commit ]; then data_words "${W[@]:2}"
      elif [[ " ${W[*]} " == *" push "* ]] && push_allowed; then data_words "${W[@]}"
      fi ;;
    gh) if [[ "${W[1]:-} ${W[2]:-}" =~ ^(pr|issue)\ (create|comment|edit)$ ]]; then data_words "${W[@]:3}"; fi ;;
    grep|rg)
      # rg --pre runs a command on each file.
      [[ " ${W[*]} " != *" --pre"* ]] || return 0
      for ((i = 1; i < ${#W[@]}; i++)); do
        if [ "${W[i]}" = -- ]; then data_words "${W[@]:i+1}"; break; fi
        if [[ "${W[i]}" != -* ]]; then data_words "${W[i]}"; fi
      done ;;
    *)
      printer || return 0
      if [ -z "$sub" ] && [ "$QUIET" -eq 1 ] || { [ -n "$sub" ] && [ -n "${DATA_SUB[$sub]+x}" ] && [ -z "${SUB_BAD[$sub]+x}" ]; }; then
        data_words "${W[@]:1}"
        # An unquoted heredoc body runs its substitutions, which nothing here parses.
        # shellcheck disable=SC2016 # the patterns are literal text
        if [[ "$stdin" != *'$('* && "$stdin" != *'`'* ]]; then count_tokens data "$stdin"; fi
      fi ;;
  esac
}

# exempt <command>: true when a full parse proves every mention harmless. The tokenizer must read the whole text with
# each pattern word in a parsed word as often as in the raw text, the line must define no function (it could redefine
# a printer), and once proven data is taken out no pattern may be left.
exempt() {
  local cmd="$1" idx w lead_cd='^[[:space:]]*cd[[:space:]]+(-[LP][[:space:]]+)?(/[A-Za-z0-9._/@+-]*)[[:space:]]*&&(.*)$'
  CMDS=(); CMD_STDIN=(); CMD_RAW=(); CMD_SUB=(); LOOSE=0; TOKENIZE_CALLS=0; SUB_SERIAL=0; FUNC_DEF=0
  DIR_UNSURE=0; GIT_ENV_CONFIG=0; RUN_DIR="$SESSION_DIR"; DATA_SUB=(); SUB_BAD=()
  # `cd <absolute path> && rest` runs all of rest there when the cd succeeds. ".." is refused: the shell resolves it
  # against the path as written, git -C against the symlink target.
  if [[ "$cmd" =~ $lead_cd ]] && [[ "/${BASH_REMATCH[2]}/" != */../* ]]; then
    RUN_DIR="${BASH_REMATCH[2]}"; cmd="${BASH_REMATCH[3]}"
    count_tokens parsed "$RUN_DIR"; count_tokens data "$RUN_DIR"
  fi
  QUIET=1
  if [[ "$cmd" == *[\|\>]* || "$cmd" == *'<('* ]]; then QUIET=0; fi
  tokenize "$cmd"
  [ "$LOOSE" -eq 0 ] || return 1
  for ((idx = 0; idx < ${#CMDS[@]}; idx++)); do note_changes "$idx"; done
  [ "$FUNC_DEF" -eq 0 ] || return 1
  # A substitution's commands come before the command that holds it, so walking back reaches the holder first.
  for ((idx = ${#CMDS[@]} - 1; idx >= 0; idx--)); do classify "$idx"; done
  for w in "${!PWORDS[@]}"; do [ "${CNT[parsed:$w]:-0}" -eq "${CNT[raw:$w]:-0}" ] || return 1; done
  ! mentions pool
}

# ---- guards ------------------------------------------------------------------------------------------------------

guard_lead_only() {
  local cmd
  MATCHED=""
  PUSH_HINT="push explicitly: git push <remote> <your-branch>"
  load_patterns
  if [ "$VALID" -eq 0 ]; then
    count_tokens raw "$INPUT"
    if mentions raw; then
      note "hook input is not valid JSON but names a lead-only command"
      SID=""; ROLE="none"
      refuse_not_lead lead-only "\`$MATCHED\` is lead-only" "ask the lead to run it; the lead is the session registered with role lead"
    fi
    note "hook input is not a JSON object: guard skipped"
    exit 0
  fi
  [ "$(jstr tool_name)" = Bash ] || exit 0
  cmd="$(jstr tool_input.command)"
  [ -n "$cmd" ] || exit 0
  count_tokens raw "$cmd"
  mentions raw || exit 0
  lookup_caller
  [ "$ROLE" != lead ] || exit 0
  if exempt "$cmd"; then exit 0; fi
  if [[ "$MATCHED" == *@default* ]]; then
    refuse_not_lead lead-only "this \`git push\` form is lead-only: a lane pushes only one named non-default branch" \
      "$PUSH_HINT (with -u or --force-with-lease if needed), as its own command or after one leading cd; ask the lead for any other push, or change lead_only_commands in .lanes/guards.md"
  fi
  refuse_not_lead lead-only "the command names \`$MATCHED\`, which is lead-only, and the guard cannot prove each mention is only text" \
    "ask the lead to run it. Text that names it passes as a git commit message, a gh pr or issue title or body, an echo, printf or cat with nothing reading its output, or a grep or rg pattern; or change lead_only_commands in .lanes/guards.md"
}

guard_plan_message() {
  local marker msg trimmed
  [ "$VALID" -eq 1 ] || { note "hook input is not a JSON object: guard skipped"; exit 0; }
  [ "$(jstr tool_name)" = SendMessage ] || exit 0
  msg="$(jstr tool_input.message)"
  [ -n "$msg" ] || exit 0
  marker="$(setting plan_marker "PLAN:")"
  trimmed="${msg#"${msg%%[![:space:]]*}"}"
  [[ "$trimmed" == "$marker"* ]] || exit 0
  lookup_caller
  [ "$ROLE" != lead ] || exit 0
  refuse_not_lead plan-message "a message starting with \"$marker\" is a plan, and plans come from the lead" \
    "send the lead facts (file:line, what you ran, what you ruled out), or the plain text without the marker"
}

# canon <path>: the physical path, resolving symlinks, even when the file or its directories do not exist yet.
canon() {
  local p="$1" hops=0 t tail="" anc
  while [ -L "$p" ] && [ "$hops" -lt 20 ]; do
    t="$(readlink "$p")"
    case "$t" in /*) p="$t" ;; *) p="$(dirname "$p")/$t" ;; esac
    hops=$((hops + 1))
  done
  anc="$p"
  while [ ! -e "$anc" ] && [ ! -L "$anc" ] && [ "$anc" != "/" ]; do
    tail="/$(basename "$anc")$tail"
    anc="$(dirname "$anc")"
  done
  if [ -d "$anc" ]; then
    printf '%s%s' "$(cd -P "$anc" && pwd -P)" "$tail"
  else
    printf '%s/%s%s' "$(cd -P "$(dirname "$anc")" && pwd -P)" "$(basename "$anc")" "$tail"
  fi
}

# under <path> <root>
under() { [ "$1" = "$2" ] || [[ "$1" == "$2"/* ]]; }

guard_main_edit() {
  local tool path enabled listing line target main root rel top hint inside=0
  local -a roots=()
  [ "$VALID" -eq 1 ] || { note "hook input is not a JSON object: guard skipped"; exit 0; }
  tool="$(jstr tool_name)"
  case "$tool" in
    Edit|Write) path="$(jstr tool_input.file_path)" ;;
    NotebookEdit) path="$(jstr tool_input.notebook_path)" ;;
    *) exit 0 ;;
  esac
  [ -n "$path" ] || exit 0
  enabled="$(setting main_checkout_guard off)"
  [[ "$enabled" =~ ^(on|yes|true|1)$ ]] || exit 0

  listing="$(git -C "$SESSION_DIR" worktree list --porcelain 2>/dev/null || true)"
  if [ -z "$listing" ]; then
    note "session directory $SESSION_DIR is not a git checkout: main-checkout guard skipped"
    exit 0
  fi
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) roots+=("$(canon "${line#worktree }")") ;;
      bare) exit 0 ;;
    esac
  done <<<"$listing"
  # With only the main checkout there is nothing to protect.
  [ "${#roots[@]}" -ge 2 ] || exit 0

  case "$path" in /*) ;; *) path="$SESSION_DIR/$path" ;; esac
  target="$(canon "$path")"
  main="${roots[0]}"
  under "$target" "$main" || exit 0
  for root in "${roots[@]:1}"; do
    if under "$target" "$root"; then inside=1; fi
  done
  [ "$inside" -eq 0 ] || exit 0

  if [[ "$(setting lead_exempt_main_checkout no)" =~ ^(on|yes|true|1)$ ]]; then
    lookup_caller
    [ "$ROLE" != lead ] || exit 0
  fi

  rel="${target#"$main"/}"
  top="$(git -C "$SESSION_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$top" ] && [ "$(canon "$top")" != "$main" ]; then hint="$(canon "$top")/$rel"; else hint="${roots[1]}/$rel (or another linked worktree)"; fi
  deny "lanes-guards rule main-edit: $path is inside the main checkout ($main) while lanes work in linked worktrees. Allowed path: the same file in a worktree, $hint. The lead may be exempted with lead_exempt_main_checkout: yes in .lanes/guards.md."
}

# no_jq: without jq the caller cannot be identified, so a call whose raw text names a lead-only command is refused (exit 2
# feeds stderr to the model) and any other call passes with a note.
no_jq() {
  CWD="${CLAUDE_PROJECT_DIR:-$PWD}"
  find_config
  if [ "$NAME" = lead-only ]; then
    load_patterns
    count_tokens raw "$INPUT"
    if mentions raw; then
      note "jq not found, and the call names \`$MATCHED\`, which is lead-only: refused because the caller cannot be identified. Install jq, or ask the lead to run it."
      exit 2
    fi
  fi
  note "jq not found: the $NAME guard is skipped; install jq"
  exit 0
}

# ---- main --------------------------------------------------------------------------------------------------------

NAME="${1:-}"
case "$NAME" in
  lead-only|plan-message|main-edit) ;;
  *) echo "lanes-guard: usage: lanes-guard lead-only|plan-message|main-edit (PreToolUse JSON on stdin)" >&2; exit 2 ;;
esac
INPUT="$(cat || true)"
command -v jq >/dev/null 2>&1 || no_jq
VALID=1
jq -e 'type == "object"' >/dev/null 2>&1 <<<"$INPUT" || VALID=0
SID=""; CWD=""
if [ "$VALID" -eq 1 ]; then
  SID="$(jstr session_id)"
  CWD="$(jstr cwd)"
fi
[ -n "$CWD" ] && [ -d "$CWD" ] || CWD="${CLAUDE_PROJECT_DIR:-$PWD}"
# Not named GIT_DIR: git reads that variable from the environment, so an inherited export would retarget every git -C.
SESSION_DIR="$CWD"
ROLE="none"; CALLER_LANE=""; MATCHED=""
find_config

case "$NAME" in
  lead-only) guard_lead_only ;;
  plan-message) guard_plan_message ;;
  main-edit) guard_main_edit ;;
esac
