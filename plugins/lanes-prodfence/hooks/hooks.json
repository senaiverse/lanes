{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|WebFetch|ReadMcpResourceTool",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/lanes-prodfence", "args": ["guard"], "onFailure": "block" }]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/lanes-prodfence", "args": ["guard"], "onFailure": "block" }]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/lanes-prodfence", "args": ["guard"], "onFailure": "block" }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/lanes-prodfence", "args": ["session-start"] }]
      }
    ]
  }
}
