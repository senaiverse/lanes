#!/usr/bin/env bash
# Production fence hooks: `guard` (PreToolUse) and `session-start` (SessionStart). Only the human acts on production.
# guard refuses a Bash, MCP or WebFetch call whose input mentions a production marker, and an edit of a protected path.
# It matches loosely and fails closed: a broken config, a missing jq or malformed input blocks the call with exit 2.
[ "${BASH_VERSINFO[0]}" -ge 4 ] || { echo "${0##*/}: requires Bash 4 or newer: on macOS run 'brew install bash'" >&2; exit 2; }
set -euo pipefail

ME=lanes-prodfence
CONFIG_REL=.lanes/prodfence.md
REPORT="report it at https://github.com/senaiverse/lanes/issues"
MODE="${1:-}"
case "$MODE" in
  guard | session-start) ;;
  *) printf '%s: usage: %s guard|session-start, with the hook input on stdin\n' "$ME" "$ME" >&2; exit 2 ;;
esac

# Exit 2 is the only code that blocks a PreToolUse call, so an unexpected failure (set -e exits 1) is turned into one.
# shellcheck disable=SC2329  # invoked by the EXIT trap
block_on_failure() {
  local rc=$?
  if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then
    echo "$ME: internal error (exit $rc): refusing the call: $REPORT" >&2
    exit 2
  fi
}
if [ "$MODE" = guard ]; then trap block_on_failure EXIT; fi

HAVE_JQ=0
command -v jq >/dev/null 2>&1 && HAVE_JQ=1

# A session-start note goes to stderr and, as systemMessage, to the human; stderr of an exit-0 hook reaches only the debug log.
note() {
  printf '%s\n' "$1" >&2
  if [ "$HAVE_JQ" -eq 1 ]; then jq -cn --arg m "$1" '{systemMessage: $m}'; fi
}

# A broken fence must not open: guard refuses with exit 2, session-start warns the human and lets the session start.
# Messages name files and line numbers, never a marker, because markers can be private.
broken() {
  local msg="$ME: $1: refusing every guarded call until it is fixed: $2"
  if [ "$MODE" = guard ]; then printf '%s\n' "$msg" >&2; exit 2; fi
  note "$msg"
  exit 0
}

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  printf '%s' "${s%"${s##*[![:space:]]}"}"
}

# One marker from a list line: surrounding whitespace and one pair of backticks removed.
clean_marker() {
  local m
  m="$(trim "$1")"
  if [ "${#m}" -ge 2 ] && [[ $m == \`*\` ]]; then m="${m:1:${#m}-2}"; fi
  trim "$m"
}

# jq_text <jq arguments>: jq's text output without carriage returns, keeping jq's exit status. A native jq.exe under Git
# Bash writes CRLF (jq manual, --binary), and a trailing CR would make "Edit" or a path compare unequal.
jq_text() {
  local out
  out="$(jq "$@")" || return
  printf '%s\n' "${out//$'\r'/}"
}

# to_posix <path>: a Windows path (C:\x, C:/x or \\host\share), as Claude Code on Windows sends it, in the POSIX form the
# shell's file tests and the project root use; any other path unchanged. Without cygpath it cannot be read: exit 2.
to_posix() {
  case "$1" in
    [A-Za-z]:[\\/]* | \\\\*)
      command -v cygpath >/dev/null 2>&1 \
        || { echo "$ME: a Windows path needs cygpath (Git Bash) to be checked: refusing the call: $REPORT" >&2; exit 2; }
      cygpath -u -- "$1"
      ;;
    *) printf '%s\n' "$1" ;;
  esac
}

INPUT="$(</dev/stdin)"
CWD="$PWD"
if [ "$HAVE_JQ" -eq 1 ]; then
  in_cwd="$(jq_text -r 'if type == "object" and (.cwd | type) == "string" then .cwd else empty end' <<<"$INPUT" 2>/dev/null || true)"
  in_cwd="$(to_posix "$in_cwd")"
  case "$in_cwd" in /*) CWD="$in_cwd" ;; esac
fi
[ -z "${CLAUDE_PROJECT_DIR:-}" ] || CLAUDE_PROJECT_DIR="$(to_posix "$CLAUDE_PROJECT_DIR")"

# The project root holding .lanes/prodfence.md: CLAUDE_PROJECT_DIR first, then upward from the session cwd.
# A dangling symlink counts as present, so a config on an unmounted volume fails closed instead of turning the fence off.
has_config() { [ -e "$1/$CONFIG_REL" ] || [ -L "$1/$CONFIG_REL" ]; }

find_root() {
  local dir="$CWD"
  if [ -n "${CLAUDE_PROJECT_DIR:-}" ] && has_config "$CLAUDE_PROJECT_DIR"; then
    printf '%s\n' "$CLAUDE_PROJECT_DIR"
    return
  fi
  while :; do
    if has_config "$dir"; then printf '%s\n' "${dir:-/}"; return; fi
    [ -n "$dir" ] && [ "$dir" != / ] || return 0
    dir="${dir%/*}"
  done
}

MARKERS=()
GLOBS=()
SPLIT=()
FILE_CONTENT=off

# split_list <value>: sets SPLIT to the trimmed items of a JSON array of strings or of a list separated by ; or newlines.
# It runs in the main shell, never in a subshell, so a malformed value reaches broken and stops the script.
split_list() {
  local v item
  SPLIT=()
  v="$(trim "$1")"
  if [[ $v == '['* ]]; then
    v="$(jq_text -r 'if type == "array" and all(.[]; type == "string") then .[] else error("not a list of strings") end' <<<"$v" 2>/dev/null)" \
      || broken "a markers or protected_paths value starting with [ is not a JSON array of strings" "write it as a list separated by ';'"
  else
    v="${v//;/$'\n'}"
  fi
  while IFS= read -r item; do
    item="$(trim "$item")"
    [ -z "$item" ] || SPLIT+=("$item")
  done <<<"$v"
}

BOM=$'\xef\xbb\xbf'

# One config line: the first line loses a UTF-8 BOM, every line loses its CR and surrounding whitespace.
clean_line() {
  local line="${2%$'\r'}"
  [ "$1" -ne 1 ] || line="${line#"$BOM"}"
  trim "$line"
}

# Messages name a markers_file by its base name only, because its full path can be private.
load_markers_file() {
  local file="$1" line m n=0 before="${#MARKERS[@]}"
  case "$file" in
    \~/*) file="$HOME/${file:2}" ;;
    /*) ;;
    *) file="$ROOT/.lanes/$file" ;;
  esac
  [ -f "$file" ] && [ -r "$file" ] || broken "cannot read markers_file ${file##*/}" "create it or fix its permissions"
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line="$(clean_line "$n" "$line")"
    case "$line" in '' | '#'*) continue ;; '- '*) line="${line#- }" ;; esac
    m="$(clean_marker "$line")"
    [ -z "$m" ] || MARKERS+=("$m")
  done <"$file"
  [ "${#MARKERS[@]}" -gt "$before" ] || broken "markers_file ${file##*/} lists no markers" "add one marker per line"
}

# Reads .lanes/prodfence.md. A line starting with words and a colon is a key, compared ignoring case with spaces and
# hyphens read as underscores; an unknown or repeated key is an error, because a mistyped key would open the fence.
# `- ` items under a heading containing "Markers" are markers; under any other level-2+ heading they are an error.
load_config_file() {
  local file="$1" line key value n=0 section=intro seen=" " markers_file="" heading
  [ -f "$file" ] && [ -r "$file" ] || broken "cannot read $file" "make it a readable file, or remove it to turn the fence off"
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line="$(clean_line "$n" "$line")"
    [ -n "$line" ] || continue
    if [[ $line == '#'* ]]; then
      heading="$(trim "${line##*#}")"
      if [[ ${heading,,} == *markers* ]]; then section=markers
      elif [[ $line == '##'* ]]; then section=other
      else section=intro; fi
      continue
    fi
    if [[ $line == '- '* ]]; then
      case "$section" in
        markers)
          value="$(clean_marker "${line#- }")"
          [ -n "$value" ] || broken "$file line $n is an empty marker" "remove the line or fill it in"
          MARKERS+=("$value")
          ;;
        other) broken "$file line $n is a '- ' item under a heading that is not a Markers heading" "move markers under a heading containing 'Markers', or remove the item" ;;
      esac
      continue
    fi
    if ! [[ $line =~ ^([A-Za-z][A-Za-z_\ -]*):(.*)$ ]]; then
      [ "$section" != markers ] || broken "$file line $n under Markers is not a '- marker' item" "write each marker as '- <marker>'"
      continue
    fi
    key="$(trim "${BASH_REMATCH[1]}")"
    key="${key,,}"
    key="${key//[ -]/_}"
    value="$(trim "${BASH_REMATCH[2]}")"
    case "$key" in
      markers_file | fence_file_content | protected_paths) ;;
      *) broken "$file line $n has an unknown key $key" "use markers_file, fence_file_content or protected_paths (see the plugin's templates/prodfence.md)" ;;
    esac
    [[ $seen != *" $key "* ]] || broken "$file line $n repeats the key $key" "keep one $key line"
    seen+="$key "
    case "$key" in
      markers_file) markers_file="$value" ;;
      fence_file_content)
        case "$value" in on | off) FILE_CONTENT="$value" ;; *) broken "$file line $n: fence_file_content must be on or off" "write 'fence_file_content: on' or 'off'" ;; esac
        ;;
      protected_paths) split_list "$value"; GLOBS+=(${SPLIT[@]+"${SPLIT[@]}"}) ;;
    esac
  done <"$file"
  [ -z "$markers_file" ] || load_markers_file "$markers_file"
}

# Sets ROOT, MARKERS, GLOBS and FILE_CONTENT, and returns 1 when nothing configures the fence.
load_config() {
  local item opt_markers opt_paths
  opt_markers="$(trim "${CLAUDE_PLUGIN_OPTION_MARKERS:-}")"
  opt_paths="$(trim "${CLAUDE_PLUGIN_OPTION_PROTECTED_PATHS:-}")"
  ROOT="$(find_root)"
  [ -n "$ROOT" ] || [ -n "$opt_markers" ] || [ -n "$opt_paths" ] || return 1
  ROOT="${ROOT:-${CLAUDE_PROJECT_DIR:-$CWD}}"
  [ "$HAVE_JQ" -eq 1 ] || broken "jq not found" "install jq (https://jqlang.org)"
  if has_config "$ROOT"; then load_config_file "$ROOT/$CONFIG_REL"; fi
  # Only ; separates markers, so "a, b" is refused rather than read as one marker that never matches.
  [[ $opt_markers == '['* || $opt_markers != *,* ]] || broken "the markers option contains a comma" "separate markers with ';'"
  split_list "$opt_markers"
  for item in ${SPLIT[@]+"${SPLIT[@]}"}; do
    item="$(clean_marker "$item")"
    [ -z "$item" ] || MARKERS+=("$item")
  done
  split_list "$opt_paths"
  GLOBS+=(${SPLIT[@]+"${SPLIT[@]}"})
  if [ "${#MARKERS[@]}" -eq 0 ]; then
    [ "${#GLOBS[@]}" -eq 0 ] || broken "protected_paths are set but no markers are listed" "add at least one marker to $CONFIG_REL, its markers_file or the markers option"
    broken "the fence is configured but lists no markers" "add markers to $CONFIG_REL, its markers_file or the markers option"
  fi
}

if [ "$MODE" = session-start ]; then
  if ! load_config; then
    note "$ME: inactive: no $CONFIG_REL and no markers option, so production calls are not fenced: copy the plugin's templates/prodfence.md to $CONFIG_REL to turn it on"
  fi
  exit 0
fi

load_config || exit 0

TOOL="$(jq_text -er 'if type == "object" and (.tool_name | type) == "string" and (.tool_input | type) == "object" then .tool_name else error("bad") end' <<<"$INPUT" 2>/dev/null)" \
  || { echo "$ME: the hook input is not a PreToolUse object with tool_name and tool_input: refusing the call: $REPORT" >&2; exit 2; }

deny() {
  jq -cn --arg r "$ME: This touches production ($1 in $2). Ask the human to run it." \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
  exit 0
}

# first_hit <needle>...: prints the first field whose text contains a needle, ignoring ASCII case, or nothing. The whole
# serialized input is the last field, so a needle in a key still matches; a field name holding a needle reads tool_input.
first_hit() {
  # shellcheck disable=SC2016  # the single-quoted text is a jq program, not shell
  LANES_PRODFENCE_NEEDLES="$(printf '%s\n' "$@")" jq_text -r '
    (env.LANES_PRODFENCE_NEEDLES | split("\n") | map(select(length > 0) | ascii_downcase)) as $ns
    | def hit: ascii_downcase as $v | any($ns[]; . as $n | $v | contains($n));
    ([{f: "tool_name", v: .tool_name}]
      + [.tool_input | paths(scalars) as $p | {f: (["tool_input"] + ($p | map(tostring)) | join(".")), v: (getpath($p) | tostring)}]
      + [{f: "tool_input", v: (.tool_input | tojson)}])
    | map(select(.v | hit)) | first // empty
    | if (.f | hit) then "tool_input" else .f end' <<<"$INPUT"
}

# collapse <absolute path>: the path with "", "." and ".." components removed lexically.
collapse() {
  local part parts=() out=()
  IFS=/ read -ra parts <<<"$1"
  for part in ${parts[@]+"${parts[@]}"}; do
    case "$part" in
      '' | .) ;;
      ..) [ "${#out[@]}" -eq 0 ] || unset "out[$((${#out[@]} - 1))]" ;;
      *) out+=("$part") ;;
    esac
  done
  local IFS=/
  printf '/%s' "${out[*]}"
}

# canon <path>: the real path as the kernel resolves it, portably (no readlink -f, realpath or cd -P). Components are
# walked left to right and each symlink is replaced by its target before the next "..", which climbs from where the
# link points; a missing component is kept as written, so a file that does not exist yet still gets its real parent.
canon() {
  local rest="$1" real="" part target hops=0
  [[ $rest == /* ]] || rest="$CWD/$rest"
  while :; do
    rest="${rest#"${rest%%[!/]*}"}"
    [ -n "$rest" ] || break
    part="${rest%%/*}"
    if [[ $rest == */* ]]; then rest="${rest#*/}"; else rest=""; fi
    case "$part" in
      .) continue ;;
      ..) real="${real%/*}"; continue ;;
    esac
    if [ -L "$real/$part" ] && [ "$hops" -lt 40 ]; then
      target="$(readlink "$real/$part")"
      [[ $target != /* ]] || real=""
      rest="$target/$rest"
      hops=$((hops + 1))
      continue
    fi
    real="$real/$part"
  done
  printf '%s\n' "${real:-/}"
}

# A glob with a literal directory is also kept by that directory's real path (a relative glob is read from the project
# root), so a glob written through a symlink, or naming a symlinked directory, matches the file by its real path. A glob
# without a wildcard is resolved whole. REAL_HEADS[i] is the real literal part, matched as text, and REAL_TAILS[i] the
# rest of the glob, so REAL_HEADS[i] followed by REAL_TAILS[i] is the glob by its real path.
REAL_HEADS=()
REAL_TAILS=()
real_globs() {
  local g lit head tail
  for g in ${GLOBS[@]+"${GLOBS[@]}"}; do
    [[ $g == */* ]] || continue
    lit="${g%%[\*\?\[]*}"
    if [ "$lit" = "$g" ]; then
      head="$g" tail=""
    else
      [[ $lit == */* ]] || continue
      head="${lit%/*}"
      tail="${g:${#head}}"
    fi
    [ -n "$head" ] || continue
    head="$(to_posix "$head")"
    [[ $head == /* ]] || head="$ROOT/$head"
    head="$(canon "$head")"
    REAL_HEADS+=("${head%/}${tail:+/}")
    REAL_TAILS+=("${tail#/}")
  done
}

# A glob matches the path as given, with ".." removed as text, or the real path of either, absolute or below the
# (real) project root; a glob without a slash also matches the file name. Matching ignores case on every filesystem:
# a false refusal is cheap, a miss is not.
protected() {
  local raw="$1" lex g c i hit=1 cands=()
  [ "${#GLOBS[@]}" -gt 0 ] || return 1
  [[ $raw == /* ]] || raw="$CWD/$raw"
  lex="$(collapse "$raw")"
  for c in "$raw" "$lex" "$(canon "$raw")" "$(canon "$lex")"; do
    cands+=("$c")
    [[ $c != "$ROOT"/* ]] || cands+=("${c#"$ROOT"/}")
    [[ $c != "$REAL_ROOT"/* ]] || cands+=("${c#"$REAL_ROOT"/}")
  done
  shopt -s nocasematch
  for c in "${cands[@]}"; do
    for g in "${GLOBS[@]}"; do
      # shellcheck disable=SC2053  # the right-hand side is the configured glob, matched as a pattern on purpose
      if [[ $c == $g ]] || { [[ $g != */* ]] && [[ ${c##*/} == $g ]]; }; then hit=0; break 2; fi
    done
    for i in ${REAL_HEADS[@]+"${!REAL_HEADS[@]}"}; do
      # shellcheck disable=SC2053  # the real head is literal, the tail is the configured glob
      if [[ $c == "${REAL_HEADS[i]}"${REAL_TAILS[i]} ]]; then hit=0; break 2; fi
    done
  done
  shopt -u nocasematch
  return "$hit"
}

case "$TOOL" in
  Read | Edit | Write | NotebookEdit)
    # One jq call prints "<field>=<path>"; the field name holds no "=", so the first "=" splits them.
    target="$(jq_text -r '.tool_input | if (.file_path | type) == "string" then "file_path=\(.file_path)" elif (.notebook_path | type) == "string" then "notebook_path=\(.notebook_path)" else empty end' <<<"$INPUT")"
    [ -n "$target" ] || { echo "$ME: $TOOL input has no file_path: refusing the call: $REPORT" >&2; exit 2; }
    path="$(to_posix "${target#*=}")"
    REAL_ROOT="$(canon "$ROOT")"
    real_globs
    if protected "$path"; then deny "protected path" "tool_input.${target%%=*}"; fi
    # The path is always matched against markers; the content written or replaced only with fence_file_content on.
    [ "$FILE_CONTENT" = on ] \
      || INPUT="$(jq -c '.tool_input |= with_entries(select(.key == "file_path" or .key == "notebook_path"))' <<<"$INPUT")"
    ;;
esac

field="$(first_hit "${MARKERS[@]}")"
[ -z "$field" ] || deny marker "$field"

# A shell command that names no marker can still reach production through a protected file, so it is refused when it
# mentions a protected path: each glob's literal text before its first wildcard, when that is not empty, as written
# and by its real directory.
case "$TOOL" in
  Bash | PowerShell | Monitor)
    prefixes=()
    for g in ${GLOBS[@]+"${GLOBS[@]}"}; do
      g="${g%%[\*\?\[]*}"
      [ -z "$g" ] || prefixes+=("$g")
    done
    real_globs
    for i in ${REAL_HEADS[@]+"${!REAL_HEADS[@]}"}; do
      g="${REAL_TAILS[i]}"
      prefixes+=("${REAL_HEADS[i]}${g%%[\*\?\[]*}")
    done
    if [ "${#prefixes[@]}" -gt 0 ]; then
      field="$(first_hit "${prefixes[@]}")"
      [ -z "$field" ] || deny "protected path" "$field"
    fi
    ;;
esac
exit 0
