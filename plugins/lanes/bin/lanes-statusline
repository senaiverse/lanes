#!/usr/bin/env bash
[ "${BASH_VERSINFO[0]}" -ge 4 ] || { echo "${0##*/}: requires Bash 4 or newer: on macOS run 'brew install bash'" >&2; exit 2; }
# lanes-statusline: the command a user's statusLine setting runs, through the stable link that the SessionStart hook
# keeps under the lanes data dir. It follows the link to the installed plugin and runs `lanes statusline`.
# A status line must always print, so a broken link prints a short line instead of failing.
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  target="$(readlink "$self")"
  case "$target" in /*) self="$target" ;; *) self="$(dirname "$self")/$target" ;; esac
done
lanes="$(cd "$(dirname "$self")" 2>/dev/null && pwd)/lanes"
if [[ ! -x "$lanes" ]]; then
  echo "lanes: plugin not found (start a session to refresh the link)"
  exit 0
fi
exec "$lanes" statusline
