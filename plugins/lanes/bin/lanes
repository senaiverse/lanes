#!/usr/bin/env bash
# jq programs are single-quoted on purpose: their $names are jq variables, not shell ones.
# shellcheck disable=SC2016
# Bash 4.4 or newer: before 4.4, "${a[*]}" of an empty array fails under set -u.
[ "$((BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1]))" -ge 404 ] || { echo "${0##*/}: requires Bash 4.4 or newer, not ${BASH_VERSION}: on macOS run 'brew install bash'" >&2; exit 2; }
# lanes: the session registry, the journal and the clear handshake for one lead session and its lane sessions in tmux.
#   lanes init [--claude-md yes|no] [lane...]   write the journal template into the journal dir (never overwrites)
#   lanes status [--json]                        every lane: pane, context %, activity, goal, clear-ready, handshake
#   lanes request <lane>                         lead: open a clear handshake (the lane must rewrite RESUME after it)
#   lanes clear-ready [--lane <lane>]            lane, from its work tree: refuse unless clean, pushed, RESUME valid
#   lanes clear <lane> [--wait <seconds>]        lead: refuse unless ready, idle and unchanged; send /clear and /goal
#   lanes goal <lane> <text> [--wait <seconds>]  lead: set or replace a lane's /goal through the same checks
#   lanes away on|off|status                     away mode for this project: its sessions' ask tool is refused
#   lanes journal-dir                            the journal folder for this work tree (absolute path)
#   lanes monitor-lock <name> <pid>            a watcher loop claims its name (skills/lead/MONITORS.md)
#   lanes monitor-diff <name>                    print the items of stdin whose state changed since the last pass
#   lanes register | hook prompt|ask             hook entry points (SessionStart, UserPromptSubmit, PreToolUse)
#   lanes statusline                             status line body (run through bin/lanes-statusline)
set -euo pipefail
# Exit 1, not 2: from a UserPromptSubmit hook an exit 2 would block the user's prompt. A status line prints its stdout.
if ! command -v jq >/dev/null 2>&1; then
  [[ "${1:-}" == statusline ]] && echo "lanes: jq is not installed"
  echo "lanes: jq is not installed: install jq 1.6 or newer and put it on PATH" >&2
  exit 1
fi

DATA="${LANES_DATA_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/lanes}"
REG="$DATA/lanes"
STATE="$REG/state"

# What lanes reads from the screen (Claude Code 2.1.309, tests/lanes/captures): the input line, which starts with `❯`
# and a no-break space (a dim placeholder when empty), and vim's `-- INSERT --` footer. Activity is the sessions file's.
PROMPT_MARK=$'❯\xc2\xa0'
RESUME_START='<!-- lanes:resume:start -->'
RESUME_END='<!-- lanes:resume:end -->'
RESUME_CAP=8000
# The longest goal proven to land whole in an 80x24 pane (2.1.309): at 1500 characters the input line scrolls off the
# screen, so lanes cannot see that what it typed arrived; /goal itself takes 4000 (code.claude.com/docs/en/goal).
GOAL_CAP=1400
HOOK_CAP=10000  # additionalContext over this is replaced by a file path and a preview (hooks docs)
REQUIRED_SECTIONS=("Goal" "Now" "Next step" "Links" "Running" "Suggested skills")

IDLE_GAP="${LANES_IDLE_GAP:-3}"
CLEAR_TIMEOUT="${LANES_CLEAR_TIMEOUT:-20}"
PCT_STALE="${LANES_PCT_STALE:-900}"
REQUEST_TIMEOUT="${LANES_REQUEST_TIMEOUT:-900}"
SEND_CHUNK="${LANES_SEND_CHUNK:-256}"
SEND_GAP="${LANES_SEND_GAP:-0.03}"

die() {
  echo "lanes: $1: $2" >&2
  exit "${3:-1}"
}

# ms_of <seconds>: a plain decimal number of seconds, at most three decimals, as whole milliseconds; else exit 1.
ms_of() {
  [[ "$1" =~ ^([0-9]{1,6})(\.([0-9]{1,3}))?$ ]] || return 1
  local frac="${BASH_REMATCH[3]}000"
  echo $((10#${BASH_REMATCH[1]} * 1000 + 10#${frac:0:3}))
}

# settings_check: the timing and chunk variables, checked where they enter, before any command reads one or sends a
# key. A value that is not a plain number in range is refused, never read as zero or as no limit; IDLE_GAP_MS is set here.
IDLE_GAP_MS=""
settings_check() {
  local ms
  ms="$(ms_of "$IDLE_GAP" || true)"
  int_in_range "$ms" 100 600000 ||
    die "LANES_IDLE_GAP=$IDLE_GAP is not a number of seconds from 0.1 to 600" "unset it (default 3) or pass one in that range" 2
  IDLE_GAP_MS="$ms"
  ms="$(ms_of "$SEND_GAP" || true)"
  int_in_range "$ms" 1 5000 ||
    die "LANES_SEND_GAP=$SEND_GAP is not a number of seconds from 0.001 to 5" "unset it (default 0.03) or pass one in that range" 2
  int_in_range "$CLEAR_TIMEOUT" 1 3600 ||
    die "LANES_CLEAR_TIMEOUT=$CLEAR_TIMEOUT is not a whole number of seconds from 1 to 3600" "unset it (default 20) or pass one in that range" 2
  int_in_range "$REQUEST_TIMEOUT" 0 604800 ||
    die "LANES_REQUEST_TIMEOUT=$REQUEST_TIMEOUT is not a whole number of seconds from 0 to 604800" "unset it (default 900) or pass one in that range" 2
  int_in_range "$PCT_STALE" 1 604800 ||
    die "LANES_PCT_STALE=$PCT_STALE is not a whole number of seconds from 1 to 604800" "unset it (default 900) or pass one in that range" 2
  # Over 512 characters a key burst becomes a paste, which does not dispatch a slash command (send_text).
  int_in_range "$SEND_CHUNK" 1 512 ||
    die "LANES_SEND_CHUNK=$SEND_CHUNK is not a whole number of characters from 1 to 512" "unset it (default 256) or pass one in that range" 2
  # Leading zeros are dropped, so shell arithmetic never reads a value as octal and jq gets a JSON number.
  CLEAR_TIMEOUT=$((10#$CLEAR_TIMEOUT)) REQUEST_TIMEOUT=$((10#$REQUEST_TIMEOUT)) PCT_STALE=$((10#$PCT_STALE))
  SEND_CHUNK=$((10#$SEND_CHUNK))
}

usage() {
  echo "lanes: usage: lanes init|status|request|clear-ready|clear|goal|away|journal-dir|monitor-lock|monitor-diff|register|hook|statusline (see the header of $0)" >&2
  exit 2
}

now() { date +%s; }
iso_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
valid_lane() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; }
int_in_range() { [[ "$1" =~ ^[0-9]{1,9}$ ]] && ((10#$1 >= $2 && 10#$1 <= $3)); }
hash_of() { printf '%s' "$1" | cksum | cut -d' ' -f1; }

# char_count <text>: characters by code point, an astral one counted twice so the count is never below JavaScript's
# string length; jq counts the same under every locale, while ${#x} counts bytes under LC_ALL=C.
char_count() { printf '%s' "$1" | jq -Rs '[explode[] | if . > 65535 then 2 else 1 end] | add // 0'; }

# The tmux server is the caller's own, or the private -L socket named by LANES_TMUX_SOCKET (tests). fd 9 (the mutex)
# is closed so a tmux server started here never inherits it.
tm() {
  if [[ -n "${LANES_TMUX_SOCKET:-}" ]]; then
    tmux -L "$LANES_TMUX_SOCKET" "$@" 9>&-
  else
    tmux "$@" 9>&-
  fi
}

# tmux_check: the commands that type need tmux 3.0 or newer, since send_literal sends `;` with send-keys -H, which 3.0
# added (tmux CHANGES "FROM 2.9 TO 3.0"). -V prints "tmux <version>", "tmux next-<version>", "tmux master" (a build
# from git) or, in OpenBSD base, "tmux openbsd-<OpenBSD release>": 6.6 is the first with 3.0's features (its
# ANNOUNCEMENT lists display-menu, which CHANGES puts in 3.0). Anything else is refused, never guessed.
tmux_check() {
  local v
  v="$(tm -V 2>/dev/null || true)"
  [[ "$v" == "tmux master" ]] && return 0
  if [[ "$v" =~ ^tmux\ openbsd-([0-9]+)\.([0-9]+)$ ]]; then
    ((BASH_REMATCH[1] * 100 + BASH_REMATCH[2] >= 606)) ||
      die "$v is the tmux of OpenBSD ${BASH_REMATCH[1]}.${BASH_REMATCH[2]}, older than the tmux 3.0 of OpenBSD 6.6, which lanes clear and lanes goal need (send-keys -H)" "upgrade OpenBSD or install tmux 3.0 or newer; nothing was typed" 2
    return 0
  fi
  [[ "$v" =~ ^tmux\ (next-)?([0-9]+)\.([0-9]+) ]] ||
    die "tmux -V printed '$v', not a tmux version" "lanes clear and lanes goal need tmux 3.0 or newer on PATH" 2
  ((BASH_REMATCH[2] >= 3)) ||
    die "$v is older than 3.0, which lanes clear and lanes goal need (send-keys -H)" "install tmux 3.0 or newer; nothing was typed" 2
}

# The plugin root, from this script's own path with symlinks followed (CLAUDE_PLUGIN_ROOT is absent in the Bash tool).
plugin_root() {
  local self="${BASH_SOURCE[0]}" target
  while [[ -L "$self" ]]; do
    target="$(readlink "$self")"
    case "$target" in /*) self="$target" ;; *) self="$(dirname "$self")/$target" ;; esac
  done
  (cd "$(dirname "$self")/.." && pwd)
}

# ---- locks: a symlink whose target "<pid>.<start tag>" names its holder ------------------------------------------

# lock_tag <pid>: the one name of a lock holder, "<pid>.<checksum of its start time (proc_start)>"; fails, printing
# nothing, for a pid that does not run, a zombie, or a start time or checksum that cannot be read. A reused pid gets
# another tag.
lock_tag() {
  local h
  proc_start_get "$1" || return 1
  h="$(hash_of "$PS_VALUE")" && [[ "$h" =~ ^[0-9]+$ ]] || return 1
  printf '%s.%s' "$1" "$h"
}

# holder_state <target>: the one liveness rule for every lock. Exits 0 when the holder the target names runs as the same
# process, 1 only on proof it does not (a malformed target, no such pid, a zombie, a start time that differs), and 2
# when a check failed for a running pid; only 1 lets a lock be broken, since a failed ps or cksum proves nothing.
holder_state() {
  local pid="${1%%.*}" rc=0 h
  [[ "$pid" =~ ^[0-9]+$ && "$1" == "$pid".?* ]] || return 1
  proc_start_get "$pid" || rc=$?
  ((rc == 0)) || return "$rc"
  h="$(hash_of "$PS_VALUE")" && [[ "$h" =~ ^[0-9]+$ ]] || return 2
  [[ "$1" == "$pid.$h" ]] || return 1
}

holder_dead() {
  local rc=0
  holder_state "$1" || rc=$?
  ((rc == 1))
}

# lock_take <path> <wait seconds> [holder pid]: ln -s creates the lock atomically with its holder in it, so it is never
# seen half-written, and sets LOCK_MINE, the target to release with; a lock whose holder is proven dead (holder_state)
# is broken (lock_break). The acquire gives up once <wait> whole seconds have passed by SECONDS, a builtin clock (bash
# 4.4 has no EPOCHREALTIME, and date forks), so a slow liveness check never stretches it; the first try always runs.
# Exits 1 while another holder has it, and 2 when this side's own holder cannot be named (lock_tag), since then no
# lock can be taken or broken at all; LOCK_WHY says which, for the refusal.
LOCK_MINE=""
LOCK_WHY=""
lock_take() {
  # The holder is read here: inside the $(...) below, BASHPID would be that subshell's.
  local path="$1" end=$((SECONDS + $2)) first=1 seen holder="${3:-$BASHPID}" rc
  LOCK_MINE="$(lock_tag "$holder")" || { LOCK_MINE=""; lock_unnamed "$holder" "this lock's holder"; return 2; }
  until ln -s "$LOCK_MINE" "$path" 2>/dev/null; do
    ((first || SECONDS < end)) || { LOCK_MINE=""; LOCK_WHY="held by another process (pid $(lock_holder "$path"))"; return 1; }
    first=0
    seen="$(readlink "$path" 2>/dev/null || true)"
    if [[ -n "$seen" ]] && holder_dead "$seen"; then
      rc=0
      lock_break "$path" "$seen" || rc=$?
      ((rc == 0)) && continue
      ((rc == 2)) && { LOCK_MINE=""; lock_unnamed "$BASHPID" "the lanes process breaking a dead holder's lock"; return 2; }
    fi
    sleep 0.1
  done
}

# lock_unnamed <pid> <its part>: the reason no lock can be taken when the start time of that pid cannot be read.
lock_unnamed() { LOCK_WHY="the start time of pid $1, $2, could not be read (ps or /proc failed), so lanes cannot name it in the lock"; }

lock_holder() { local t; t="$(readlink "$1" 2>/dev/null || true)"; echo "${t%%.*}"; }

# lock_drop <path> <target>: remove the lock only while it still has that target.
lock_drop() { [[ "$(readlink "$1" 2>/dev/null || true)" == "$2" ]] && rm -f "$1"; return 0; }

# lock_break <path> <target seen dead>: one breaker at a time holds <path>.break, and it removes the lock only if the
# lock still has the target it saw dead, so a lock that a live process took meanwhile is never removed. A marker left
# by a breaker proven dead is dropped and the marker taken again in the same call. Exits 1 when another breaker is live
# or undecided, and 2 when this process cannot be named (lock_tag).
lock_break() {
  local marker="$1.break" me="$BASHPID" mine cur try
  mine="$(lock_tag "$me")" || return 2
  for try in 1 2; do
    if ln -s "$mine" "$marker" 2>/dev/null; then
      lock_drop "$1" "$2"
      lock_drop "$marker" "$mine"
      return 0
    fi
    ((try == 1)) || return 1
    cur="$(readlink "$marker" 2>/dev/null || true)"
    [[ -z "$cur" ]] || { holder_dead "$cur" && lock_drop "$marker" "$cur"; } || return 1
  done
}

# ---- mutex: one short lock around every registry and state write -------------------------------------------------

MUTEX_HELD=0
MUTEX_MINE=""
# mutex_take <seconds>: flock where it exists, else the symlink lock (stock macOS); exits as lock_take, with LOCK_WHY.
mutex_take() {
  mkdir -p "$STATE"
  if [[ -z "${LANES_NO_FLOCK:-}" ]] && command -v flock >/dev/null 2>&1; then
    exec 9>"$STATE/.mutex"
    flock -w "$1" 9 || { LOCK_WHY="held by another process"; return 1; }
  else
    lock_take "$STATE/.mutex.lnk" "$1" || return
    MUTEX_MINE="$LOCK_MINE"
  fi
  MUTEX_HELD=1
}

# mutex_refusal <mutex_take's exit status>: the one wording of a mutex not taken; "registry locked" only when another
# process holds it, since a lanes that cannot name itself (exit 2) would be refused by every holder alike.
mutex_refusal() {
  if [[ "$1" == 2 ]]; then echo "registry lock not taken: $LOCK_WHY"; else echo "registry locked by another lanes process"; fi
}

mutex_drop() {
  ((MUTEX_HELD)) || return 0
  MUTEX_HELD=0
  exec 9>&-
  [[ -n "$MUTEX_MINE" ]] && lock_drop "$STATE/.mutex.lnk" "$MUTEX_MINE"
  MUTEX_MINE=""
}

# One exit path: a TERM (the status line is cancelled that way) still drops the mutex, the clear lock and a temp file.
ATOMIC_TMP=""
CLEAR_LOCK=""
CLEAR_MINE=""
on_exit() {
  mutex_drop
  [[ -n "$ATOMIC_TMP" ]] && rm -f "$ATOMIC_TMP"
  [[ -n "$CLEAR_LOCK" ]] && lock_drop "$CLEAR_LOCK" "$CLEAR_MINE"
  return 0
}
trap on_exit EXIT
trap 'exit 143' TERM INT

# ---- JSON files --------------------------------------------------------------------------------------------------

# write_atomic <file> <content>: a temp file in the same directory, then mv, so a reader never sees half a file.
# Empty content is refused: it only comes from an update that failed, and it would erase the file.
write_atomic() {
  [[ -n "$2" ]] || { echo "lanes: refusing to write empty content to $1: the update that produced it failed" >&2; return 1; }
  local dir
  dir="$(dirname "$1")"
  mkdir -p "$dir"
  ATOMIC_TMP="$(mktemp "$dir/.tmp.XXXXXX")"
  printf '%s\n' "$2" >"$ATOMIC_TMP"
  mv -f "$ATOMIC_TMP" "$1"
  ATOMIC_TMP=""
}

reg_file() { printf '%s/%s.json' "$REG" "$1"; }
state_file() { printf '%s/%s.json' "$STATE" "$1"; }

# reg_read <lane>: print the entry; exit 1 when missing, 2 when not a valid registry object.
reg_read() {
  local f
  f="$(reg_file "$1")"
  [[ -f "$f" ]] || return 1
  jq -ce 'select(type == "object" and (.lane | type == "string") and has("session_id"))' "$f" 2>/dev/null || return 2
}

# state_read <lane>: the lane's session bookkeeping (session id, prompt count, last slash command, transcript path,
# context-% time) and handshake record, or {} when missing or unreadable. Activity is never stored: lane_activity reads it.
state_read() {
  local f
  f="$(state_file "$1")"
  [[ -f "$f" ]] && jq -ce 'select(type == "object")' "$f" 2>/dev/null || echo '{}'
}

# state_update <lane> <jq filter> [jq args...]: read, apply, write under the caller's mutex; a failed jq writes nothing.
state_update() {
  local lane="$1" filter="$2" cur out
  shift 2
  cur="$(state_read "$lane")"
  out="$(jq -c "$@" "$filter" <<<"$cur")" || { echo "lanes: state update for '$lane' failed: left as it was" >&2; return 1; }
  write_atomic "$(state_file "$lane")" "$out"
}

# reg_update <lane> <jq filter> [jq args...]: same for a registry entry that must already be valid.
reg_update() {
  local lane="$1" filter="$2" cur out
  shift 2
  cur="$(reg_read "$lane")" || return 1
  out="$(jq -c --arg now "$(iso_now)" "$@" "$filter | .updated_at = \$now" <<<"$cur")" ||
    { echo "lanes: registry update for '$lane' failed: left as it was" >&2; return 1; }
  write_atomic "$(reg_file "$lane")" "$out"
}

# ---- native session state: Claude Code's own per-process file ---------------------------------------------------

# Claude Code writes <config dir>/sessions/<pid>.json for each running session; CLAUDE_CONFIG_DIR overrides the
# default ~/.claude (code.claude.com/docs/en/env-vars), so register records each lane's own. The file is undocumented,
# so tests/lanes/live pins its schema.
OS_NAME="$(uname -s)"

# session_read <pid> <config dir>: the one reader of that file, under the lane's own config dir (empty: ~/.claude).
# Sets SS_PID, SS_PROCSTART, SS_SID, SS_STATUS, SS_WAITING, SS_UPDATED (ms) and SS_AGE_MS; else sets SS_PROBLEM and
# returns 1. A missing or empty file, bad JSON, a missing or mistyped key, a control character, a sessionId that is not
# a session id, or a status outside idle|busy|waiting|shell is refused, never guessed.
session_read() {
  local f
  f="${2:-$HOME/.claude}/sessions/$1.json"
  SS_PROBLEM=""
  [[ -f "$f" ]] || { SS_PROBLEM="no Claude Code session file $f (the process exited, or it is not Claude Code)"; return 1; }
  [[ -s "$f" ]] || { SS_PROBLEM="the session file $f is empty"; return 1; }
  # Seven fields, the first "!<problem>" (and the rest empty) when the schema is not the known one.
  jq_fields 7 '
    def need($k; $t): if has($k) | not then "no \"\($k)\" key" elif (.[$k] | type) != $t then "\"\($k)\" is a \(.[$k] | type), not a \($t)" else empty end;
    if type != "object" then "!not a JSON object"
    else ([need("pid"; "number"), need("procStart"; "string"), need("sessionId"; "string"), need("status"; "string"),
           need("statusUpdatedAt"; "number")] | .[0]) as $p
    | ([("procStart", "sessionId", "status", "waitingFor") as $k | select(.[$k] | strings | test("[[:cntrl:]]"))
        | "\"\($k)\" holds a control character"] | .[0]) as $c
    | if $p then "!" + $p
      elif $c then "!" + $c
      elif (.status | IN("idle", "busy", "waiting", "shell") | not) then "!unknown status \"\(.status)\""
      elif .status == "waiting" and (.waitingFor | type) != "string" then "!status waiting without a waitingFor string"
      else [.pid, .procStart, .sessionId, .status, (.waitingFor // ""), .statusUpdatedAt,
            (now * 1000 - .statusUpdatedAt | floor)] end end
    | if type == "string" then ., ("", "", "", "", "", "") else .[] end' --file "$f" ||
    { SS_PROBLEM="the session file $f is not valid JSON"; return 1; }
  [[ "${FIELDS[0]}" != "!"* ]] || { SS_PROBLEM="the session file $f has an unknown schema: ${FIELDS[0]#!}"; return 1; }
  SS_PID="${FIELDS[0]}" SS_PROCSTART="${FIELDS[1]}" SS_SID="${FIELDS[2]}" SS_STATUS="${FIELDS[3]}"
  SS_WAITING="${FIELDS[4]}" SS_UPDATED="${FIELDS[5]}" SS_AGE_MS="${FIELDS[6]}"
  valid_sid "$SS_SID" || { SS_PROBLEM="the session file $f has an unknown schema: sessionId \"$SS_SID\" is not a session id"; return 1; }
}

# proc_start_get <pid>: sets PS_VALUE to the start time of a live process, computed as Claude Code computes procStart
# (2.1.309 binary): field 22 of /proc/<pid>/stat, counted after the last ")", on Linux; `LC_ALL=C TZ=UTC ps -o lstart=`
# trimmed elsewhere. Exits 1 only on proof the process is gone (no such pid, or a zombie: state Z, or X on Linux) and 2
# when the read failed for a running pid; it runs in the caller's shell, so a failed fork never reads as gone.
PS_VALUE=""
proc_start_get() {
  local s st out
  local -a f
  PS_VALUE=""
  if [[ "$OS_NAME" == Linux ]]; then
    if ! { IFS= read -r s <"/proc/$1/stat"; } 2>/dev/null; then
      [[ -e "/proc/$1" ]] && return 2
      return 1
    fi
    read -ra f <<<"${s##*) }"
    [[ "${f[0]:-}" != [ZX] ]] || return 1
    s="${f[19]:-}"
  else
    # One -o per keyword: BSD ps(1) reads the text after a keyword's "=" as its header, commas included.
    out="$(LC_ALL=C TZ=UTC ps -o stat= -o lstart= -p "$1" 2>/dev/null)" || out=""
    read -r st s <<<"$out"
    if [[ -z "$st" ]]; then
      kill -0 "$1" 2>/dev/null && return 2
      return 1
    fi
    [[ "$st" != Z* ]] || return 1
  fi
  [[ -n "$s" ]] || return 2
  PS_VALUE="$s"
}

# proc_start <pid>: prints the start time (proc_start_get), with its exit status.
proc_start() {
  proc_start_get "$1" || return
  printf '%s' "$PS_VALUE"
}

# pid_within <pid> <root>: the pid is the root or a descendant of it. The npm install runs claude as a child of a
# node wrapper, so the pane's own pid is not always Claude Code's.
pid_within() {
  local p="$1" i
  for ((i = 0; i < 64; i++)); do
    [[ "$p" == "$2" ]] && return 0
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d '[:space:]')"
    [[ "$p" =~ ^[0-9]+$ ]] && ((p > 1)) || return 1
  done
  return 1
}

# process_gone <pid> <start time recorded at registration>: the registered Claude Code process is proven gone: the pid
# is gone or a zombie, or it now runs a process that started at another time (a reused pid). An empty recorded time
# (an entry from before it was recorded) or a start time that cannot be read proves nothing.
process_gone() {
  local rc=0
  proc_start_get "$1" || rc=$?
  ((rc == 1)) || [[ "$rc" == 0 && -n "$2" && "$PS_VALUE" != "$2" ]]
}

# lane_session <lane>: the lane's session file, proven current: it names the registered pid, that process started
# when the file says (a SIGKILL leaves a stale file, and a pid can be reused), and it holds the registered session.
# Sets the SS_ values of session_read and SS_SIG, or SS_PROBLEM and exits 1 on proof the registered session no longer
# runs (its pid is gone or a zombie, a stale file, another session in it, a start time other than the one recorded at
# registration), or 2 when that cannot be decided.
lane_session() {
  local e f=() rc=0
  e="$(reg_read "$1")" || { SS_PROBLEM="the registry entry for $1 is unreadable"; return 2; }
  jq_fields 4 '(.claude_pid // "" | tostring), .session_id, (.claude_config_dir // ""), (.claude_start // "")' "$e" ||
    { SS_PROBLEM="the registry entry for $1 could not be read"; return 2; }
  f=("${FIELDS[@]}")
  [[ "${f[0]}" =~ ^[0-9]+$ ]] ||
    { SS_PROBLEM="lane $1 has no Claude Code pid registered: restart it so SessionStart records CLAUDE_PID"; return 2; }
  # A missing, unreadable or foreign file proves the session gone only once its process is (process_gone).
  if ! session_read "${f[0]}" "${f[2]}"; then
    process_gone "${f[0]}" "${f[3]}" && return 1
    return 2
  fi
  if [[ "$SS_PID" != "${f[0]}" ]]; then
    SS_PROBLEM="the session file of pid ${f[0]} names pid $SS_PID"
    process_gone "${f[0]}" "${f[3]}" && return 1
    return 2
  fi
  proc_start_get "${f[0]}" || rc=$?
  ((rc != 2)) ||
    { SS_PROBLEM="the start time of pid ${f[0]} could not be read, so its session file is not proven current"; return 2; }
  [[ "$rc" == 0 && "$PS_VALUE" == "$SS_PROCSTART" ]] ||
    { SS_PROBLEM="the session file of pid ${f[0]} is stale: it says the process started at '$SS_PROCSTART', the live one at '${PS_VALUE:-none}' (killed, or the pid was reused)"; return 1; }
  [[ "$SS_SID" == "${f[1]}" ]] ||
    { SS_PROBLEM="pid ${f[0]} now runs session $SS_SID, not the registered ${f[1]}"; return 1; }
  # SS_SIG moves on any state change, a self-started turn included (a /goal check-in, a finished background shell).
  SS_SIG="$SS_SID $SS_UPDATED"
}

# lane_activity <lane>: the one definition of a lane's activity, from its session file. Sets ACT to idle (status idle
# for at least LANES_IDLE_GAP), settling (idle for less), busy, waiting (ACT_DETAIL names what for), shell (a
# background shell runs; it outlives /clear) or unknown (ACT_DETAIL says why).
lane_activity() {
  ACT="" ACT_DETAIL=""
  if ! lane_session "$1"; then
    ACT=unknown ACT_DETAIL="$SS_PROBLEM"
    return 0
  fi
  case "$SS_STATUS" in
    idle) if ((SS_AGE_MS >= IDLE_GAP_MS)); then ACT=idle; else ACT=settling; fi ;;
    waiting) ACT=waiting ACT_DETAIL="$SS_WAITING" ;;
    *) ACT="$SS_STATUS" ;;
  esac
}

# goal_state <transcript>: active or none from the last goal_status attachment, which is met:false while a goal is
# set (the sentinel on /goal, then each unmet verdict) and met:true once it is cleared or achieved (2.1.309).
goal_state() {
  local last
  [[ -n "$1" && -r "$1" ]] || { echo unknown; return 0; }
  last="$({ grep -F '"goal_status"' "$1" || true; } | jq -c 'select(.type == "attachment" and .attachment.type == "goal_status")
    | .attachment.met' 2>/dev/null | tail -n 1)" || { echo unknown; return 0; }
  if [[ "$last" == false ]]; then echo active; else echo none; fi
}

# project_of <dir>: the project a directory belongs to, the physical path of its git common dir, so a repository and
# all its worktrees are one project; outside git, the directory's own physical path (as given when it is gone). The
# plain --git-common-dir is relative to <dir> and works on every git, where --path-format=absolute needs git 2.31.
project_of() {
  local d="${1:-$PWD}" c
  if c="$(git -C "$d" rev-parse --git-common-dir 2>/dev/null)" && c="$(cd "$d" && cd "$c" && pwd -P)"; then
    echo "$c"
  else
    (cd "$d" 2>/dev/null && pwd -P) || echo "$d"
  fi
}

# config_get <key> <dir>: a plugin option recorded for the project of <dir> (record_config), or nothing.
config_get() {
  jq -r --arg p "$(project_of "$2")" --arg k "$1" '.[$p][$k]? // empty' "$STATE/config.json" 2>/dev/null || true
}

# lane_cwd <lane>: the directory the lane registered from, whose project its options come from; empty when unknown.
lane_cwd() { reg_read "$1" 2>/dev/null | jq -r '.cwd // ""' 2>/dev/null || true; }

# threshold <dir>, journal_dir <dir>: the options of the project of <dir>; the LANES_ variables override them.
threshold() {
  local t="${LANES_THRESHOLD:-$(config_get threshold "$1")}"
  int_in_range "$t" 1 100 || t=70
  echo "$t"
}

journal_dir() {
  local d="${LANES_JOURNAL_DIR:-$(config_get journal_dir "$1")}"
  echo "${d:-.lanes}"
}

# journal_root <cwd>: an absolute journal_dir as is, else relative to the git top level of cwd (or cwd itself).
journal_root() {
  local jd top
  jd="$(journal_dir "$1")"
  if [[ "$jd" == /* ]]; then
    echo "$jd"
    return
  fi
  top="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null || echo "$1")"
  echo "$top/$jd"
}

resume_path() { printf '%s/next-%s.md' "$(journal_root "$2")" "$1"; }

# ---- RESUME block ------------------------------------------------------------------------------------------------

# resume_block <file>: the text between the markers; exit 1 when the file or a marker is missing.
resume_block() {
  [[ -f "$1" ]] || return 1
  grep -qxF "$RESUME_START" "$1" && grep -qxF "$RESUME_END" "$1" || return 1
  awk -v s="$RESUME_START" -v e="$RESUME_END" '$0 == e {on = 0} on {print} $0 == s {on = 1}' "$1"
}

# section_text <block> <heading>: the non-empty, non-comment lines under `### <heading>`.
section_text() {
  awk -v h="### $2" '
    /^### / {on = ($0 == h); next}
    on && /^[[:space:]]*<!--.*-->[[:space:]]*$/ {next}
    on && NF {print}
  ' <<<"$1"
}

# Problem functions (*_problem, resume_problems) print the reason and exit 0, or exit 0 silent when all is well; a
# non-zero exit means the check itself failed. why_of <function> [args] runs one and sets WHY to its reason, or to
# "check failed: <function>" when it failed, and check_failed tells that refusal from a reason the check found.
WHY=""
why_of() { WHY="$("$@")" || WHY="check failed: $1"; }
check_failed() { [[ "$WHY" == "check failed: "* ]]; }

# jq_fields <count> <filter> [json | --file <path>]: the one splitter of jq output into fields. Sets FIELDS to the
# <count> values the filter prints for the document (default: stdin), a string as is and any other value as JSON, each
# ended by a NUL, so a newline inside a value never shifts the next; a NUL inside a value, which no shell string holds,
# reads as U+FFFD. A last "end" value proves jq ran the whole filter, so a crash or bad input exits 1, as does another
# count.
jq_fields() {
  local prog="(($2) | if type == \"string\" then . else tojson end), \"end\" | gsub(\"\\u0000\"; \"\\ufffd\") + \"\\u0000\""
  if [[ "${3:-}" == --file ]]; then
    mapfile -d '' FIELDS < <(jq -j "$prog" "$4" 2>/dev/null)
  elif (($# >= 3)); then
    mapfile -d '' FIELDS < <(jq -j "$prog" <<<"$3" 2>/dev/null)
  else
    mapfile -d '' FIELDS < <(jq -j "$prog" 2>/dev/null)
  fi
  ((${#FIELDS[@]} == $1 + 1)) && [[ "${FIELDS[$1]}" == end ]] || return 1
  unset 'FIELDS[$1]'
}

# goal_chars <text>: the first character Claude Code 2.1.309 changes at Enter, as a refusal, or nothing. It removes an
# invisible character (default-ignorable, U+FFF9-FFFB) and then waits for a second Enter, except a joiner or variation
# selector after a symbol (an emoji's own), and composes a combining mark into the letter before it (NFC).
goal_chars() {
  jq -rn --arg t "$1" '
    def hex: [recurse(if . >= 16 then (. / 16 | floor) else empty end) | . % 16]
      | reverse | map("0123456789ABCDEF"[.:. + 1]) | add | if length < 4 then ("000" + .)[-4:] else . end;
    def invisible: . == 173 or . == 847 or . == 1564 or (. >= 4447 and . <= 4448) or (. >= 6068 and . <= 6069)
      or (. >= 6155 and . <= 6159) or (. >= 8203 and . <= 8207) or (. >= 8234 and . <= 8238)
      or (. >= 8288 and . <= 8303) or . == 12644 or (. >= 65024 and . <= 65039) or . == 65279 or . == 65440
      or (. >= 65520 and . <= 65531) or (. >= 113824 and . <= 113827) or (. >= 119155 and . <= 119162)
      or (. >= 917504 and . <= 921599);
    def combining: (. >= 768 and . <= 879) or (. >= 6832 and . <= 6911) or (. >= 7616 and . <= 7679)
      or (. >= 8400 and . <= 8447) or (. >= 65056 and . <= 65071);
    ($t | explode) as $c
    | first(range(0; $c | length) as $i | $c[$i] as $x
      | if $x < 32 or ($x >= 127 and $x <= 159) then "holds a control character (U+\($x | hex))"
        elif $x == 8232 or $x == 8233 then "holds a line or paragraph separator (U+\($x | hex)), which Enter does not submit"
        elif ($x | invisible) and (($x == 8205 or $x == 65038 or $x == 65039) and $i > 0 and $c[$i - 1] >= 8592 | not)
        then "holds the invisible character U+\($x | hex), which Claude Code removes at Enter instead of submitting"
        elif $x | combining then "holds the combining mark U+\($x | hex), which Claude Code composes into the letter before it, so the goal it gets differs from the one typed"
        else empty end) // empty'
}

# goal_problem <text>: why the text cannot be typed as `/goal <text>` and arrive as typed, or nothing. Besides
# goal_chars, a trailing backslash makes Enter insert a newline and a last token `:` plus two or more characters
# opens the emoji picker, whose Enter completes it (both measured on 2.1.309); an `@` token submits as typed.
goal_problem() {
  local n bad
  n="$(char_count "$1")" || return 1
  bad="$(goal_chars "$1")" || return 1
  if [[ -z "$1" ]]; then
    echo "is empty"
  elif [[ "$1" == *$'\n'* ]]; then
    echo "must be one line (it is typed as /goal, and a newline would submit it early)"
  elif [[ -n "$bad" ]]; then
    echo "$bad"
  elif [[ "$1" == *"\\" ]]; then
    echo "ends in a backslash, which makes Enter start a new line instead of submitting"
  elif [[ "$1" =~ (^|[[:space:]])(:[^:[:space:]]{2,})$ ]]; then
    echo "ends in '${BASH_REMATCH[2]}', which opens Claude Code's emoji picker, so Enter would complete it instead of submitting"
  elif ((n > GOAL_CAP)); then
    echo "is over $GOAL_CAP characters, the longest goal proven to arrive whole in an 80x24 pane"
  fi
  return 0
}

# resume_problems <block>: one line per problem; empty output means the block is usable.
resume_problems() {
  local block="$1" sec n
  n="$(char_count "$block")" || return 1
  if ((n > RESUME_CAP)); then
    echo "RESUME block is $n characters, over the $RESUME_CAP cap: link to files instead of copying them"
  fi
  for sec in "${REQUIRED_SECTIONS[@]}"; do
    grep -qxF "### $sec" <<<"$block" || echo "RESUME block has no '### $sec' section"
  done
  [[ -n "$(section_text "$block" "Next step")" ]] || echo "RESUME 'Next step' is empty"
  why_of goal_problem "$(section_text "$block" "Goal")"
  if check_failed; then
    echo "$WHY"
  elif [[ -n "$WHY" ]]; then
    echo "RESUME 'Goal' $WHY"
  fi
}

# ---- lookups -----------------------------------------------------------------------------------------------------

each_lane() {
  local f
  for f in "$REG"/*.json; do
    [[ -e "$f" ]] || continue
    f="${f##*/}"
    echo "${f%.json}"
  done
}

# Session index: $DATA/sessions/<session_id> holds the lane name, because only SessionStart and UserPromptSubmit carry
# session_title. A session id becomes a file name, so only a plain one is indexed.
valid_sid() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]]; }

# lane_for_session <session_id> [title]: the lane whose registry entry holds this session id, tried by the title, then
# by the index (a /rename changes the title, not the registered lane). The registry decides, so an index file left by
# a cleared session never resolves.
lane_for_session() {
  local sid="$1" lane e
  valid_sid "$sid" || return 1
  for lane in "${2:-}" "$(head -n 1 "$DATA/sessions/$sid" 2>/dev/null || true)"; do
    valid_lane "$lane" && e="$(reg_read "$lane")" && [[ "$(jq -r .session_id <<<"$e")" == "$sid" ]] && { echo "$lane"; return 0; }
  done
  return 1
}

# caller_server: the pid of the tmux server this command runs under, or nothing outside tmux. tmux sets TMUX to
# "<socket path>,<server pid>,<session id, or -1>" (environ.c environ_for_session; tmux(1) calls it internal
# information), so it is read from the right, since a socket path may hold a comma.
caller_server() { if [[ "${TMUX:-}" =~ ,([0-9]+),-?[0-9]+$ ]]; then echo "${BASH_REMATCH[1]}"; fi; }

# entry_on_pane <entry> <server pid> <pane>: the registry entry names that pane on that tmux server. A pane id is unique
# only within one server (every server's first pane is %0), so both must match, and an unknown one matches nothing.
entry_on_pane() {
  [[ -n "$2" && -n "$3" ]] &&
    [[ "$(jq -r '"\(.tmux_pid // "") \(.tmux_pane // "")"' <<<"$1" 2>/dev/null)" == "$2 $3" ]]
}

# lane_for_pane <pane> [server pid]: the lane registered on that pane of that server (default: the caller's server).
lane_for_pane() {
  local lane e server
  server="${2-$(caller_server)}"
  while IFS= read -r lane; do
    e="$(reg_read "$lane")" || continue
    entry_on_pane "$e" "$server" "${1:-}" && { echo "$lane"; return 0; }
  done < <(each_lane)
  return 1
}

# caller_lane: the registered lane of the pane this command runs in (TMUX_PANE on the caller's server), or nothing.
caller_lane() { lane_for_pane "${TMUX_PANE:-}" || true; }

# caller_project: the one rule for the caller's project (project_of): the registered cwd of the caller's lane when its
# pane is registered, else $PWD, so a lead acts from its own project whatever directory its Bash tool is in.
caller_project() {
  local lane cwd=""
  lane="$(caller_lane)"
  [[ -n "$lane" ]] && cwd="$(lane_cwd "$lane")"
  project_of "${cwd:-$PWD}"
}

# lane_project <lane>: the project of the lane's registered cwd, or nothing when the lane or its cwd is unknown.
lane_project() {
  local cwd
  cwd="$(lane_cwd "$1")"
  [[ -z "$cwd" ]] || project_of "$cwd"
}

pane_exists() { [[ -n "$1" ]] && [[ "$(tm display -p -t "$1" '#{pane_id}' 2>/dev/null)" == "$1" ]]; }
# pane_identity <pane>: "<tmux server pid> <pane pid>", or nothing when the pane cannot be read.
pane_identity() { tm display -p -t "$1" '#{pid} #{pane_pid}' 2>/dev/null; }

# ---- hooks -------------------------------------------------------------------------------------------------------

NOTICES=()
notice() {
  echo "lanes: $1" >&2
  NOTICES+=("lanes: $1")
}

# hook_emit [additional context]: the one JSON object a SessionStart hook prints; nothing when there is nothing to say.
hook_emit() {
  local ctx="${1:-}" msg=""
  ((${#NOTICES[@]})) && msg="$(printf '%s\n' "${NOTICES[@]}")"
  [[ -z "$ctx" && -z "$msg" ]] && return 0
  jq -nc --arg ctx "$ctx" --arg msg "$msg" '
    (if $msg != "" then {systemMessage: $msg} else {} end)
    + (if $ctx != "" then {hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $ctx}} else {} end)'
}

refresh_statusline_link() {
  local root="$1" tmp
  [[ -x "$root/bin/lanes-statusline" ]] || return 0
  mkdir -p "$DATA"
  tmp="$DATA/.lanes-statusline.$$"
  ln -sf "$root/bin/lanes-statusline" "$tmp" && mv -f "$tmp" "$DATA/lanes-statusline"
}

# record_config <cwd>: the plugin options this session started with, kept for the project of its cwd, since options
# can differ per project (a project's own settings) and bin/ commands run without them.
record_config() {
  local t="${CLAUDE_PLUGIN_OPTION_THRESHOLD:-}" j="${CLAUDE_PLUGIN_OPTION_JOURNAL_DIR:-}" cur
  [[ -z "$t" && -z "$j" ]] && return 0
  if [[ -n "$t" ]] && ! int_in_range "$t" 1 100; then
    notice "threshold option '$t' is not a whole number from 1 to 100: using 70"
    t=70
  fi
  cur="$(jq -ce 'select(type == "object")' "$STATE/config.json" 2>/dev/null || echo '{}')"
  write_atomic "$STATE/config.json" "$(jq -c --arg p "$(project_of "$1")" --arg t "$t" --arg j "$j" '
    .[$p] = ((.[$p] | objects) // {} | (if $t != "" then .threshold = ($t | tonumber) else . end)
      | (if $j != "" then .journal_dir = $j else . end))' <<<"$cur")"
}

# who <lane> <role>: how SessionStart names the session to the model, since the model cannot see LANES_ROLE.
who() { if [[ "$2" == lead ]]; then printf 'you are the lead "%s"' "$1"; else printf 'you are lane "%s"' "$1"; fi; }

# resume_context <lane> <role> <dir>: what SessionStart(clear) injects, never over the hook cap: the whole text is
# counted, and past the cap the lane is pointed at the file instead.
resume_context() {
  local lane="$1" role="$2" dir="$3" file block problems text n me
  me="$(who "$lane" "$role")"
  file="$(resume_path "$lane" "$dir")"
  if ! block="$(resume_block "$file")"; then
    printf 'lanes: %s, just cleared. No RESUME block was found at %s. Ask the lead for your next step before you change anything.' "$me" "$file"
    return
  fi
  n="$(char_count "$block")"
  if ((n > RESUME_CAP)); then
    printf 'lanes: %s, just cleared. Your RESUME block at %s is %s characters, over the %s cap, so it was not injected. Read that file now, then shorten the block.' "$me" "$file" "$n" "$RESUME_CAP"
    return
  fi
  why_of resume_problems "$block"
  problems="$WHY"
  text="$(printf 'lanes: %s, just cleared by the lanes handshake. Your RESUME block from %s is below; it is your state. The rules are in %s/RULES.md.\n\n%s\n\nStart with the Next step.' \
    "$me" "$file" "$(journal_root "$dir")" "$block")"
  [[ -n "$problems" ]] && text+="$(printf '\nThe block has problems: %s' "$(tr '\n' ';' <<<"$problems")")"
  n="$(char_count "$text")"
  if ((n > HOOK_CAP)); then
    printf 'lanes: %s, just cleared. Your RESUME block at %s, with its wrapper, is %s characters, over the %s-character hook cap, so it was not injected. Read that file now.' "$me" "$file" "$n" "$HOOK_CAP"
    return
  fi
  printf '%s' "$text"
}

# gc_sessions: remove index files whose lane's registry entry names another session, or that name no lane.
gc_sessions() {
  local f lane
  for f in "$DATA/sessions"/*; do
    [[ -e "$f" ]] || continue
    lane="$(head -n 1 "$f" 2>/dev/null || true)"
    valid_lane "$lane" && [[ "$(reg_read "$lane" | jq -r .session_id 2>/dev/null)" == "${f##*/}" ]] && continue
    rm -f "$f"
  done
}

# release_pane <lane> <server pid> <pane>: a pane runs one session, so any other lane entry naming that pane of that
# server (entry_on_pane) loses it (and clear-ready); the same pane id on another server is another pane.
release_pane() {
  local other e
  while IFS= read -r other; do
    if [[ "$other" != "$1" ]] && e="$(reg_read "$other")" && entry_on_pane "$e" "$2" "$3"; then
      reg_update "$other" '.tmux_pane = null | .clear_ready = false'
      notice "pane $3 was registered to lane '$other', which now has no pane"
    fi
  done < <(each_lane)
}

# name_holder <lane> <entry> <incoming Claude Code pid>: why the incoming session must not take the lane name, or
# nothing (exit 1 prints the check that could not decide). The registered process decides, never the pane or the
# session id: the same pid, or the old session proven gone (lane_session), frees it, since one process runs one session
# (/clear, /resume, /branch, while its sessions file may still name the old one); proven live, on any pane or tmux
# server, holds it, and a check that cannot decide never frees it. An entry with no claude_pid (a lanes version before
# it) proves nothing live, so its name is free.
name_holder() {
  local f=() rc=0
  jq_fields 3 '(.claude_pid // "" | tostring), .session_id, (.tmux_pane // "no pane")' "$2" ||
    { echo "reading the registry entry"; return 1; }
  f=("${FIELDS[@]}")
  [[ -z "${f[0]}" || "${f[0]}" == "$3" ]] && return 0
  lane_session "$1" || rc=$?
  ((rc == 1)) && return 0
  ((rc == 0)) || { echo "lane_session: $SS_PROBLEM"; return 1; }
  echo "lane name '$1' is already in use by session ${f[1]} (Claude Code pid ${f[0]}, pane ${f[2]}), which still runs: a lane name is unique on this machine, across projects and tmux servers. This session was not registered; restart it with another --name"
}

cmd_register() {
  local input lane sid cwd src tp pane server rc role existing old_sid held ctx="" fresh taken wt down ids cpid="${CLAUDE_PID:-}" f=()
  input="$(cat || true)"
  if ! jq_fields 5 'if type == "object" then (.session_title // ""), (.session_id // ""), (.cwd // ""), (.source // ""),
    (.transcript_path // "" | tostring) else empty end' "$input"; then
    notice "hook input is not a JSON object: nothing registered"
    hook_emit
    return 0
  fi
  f=("${FIELDS[@]}")
  lane="${f[0]}" sid="${f[1]}" cwd="${f[2]}" src="${f[3]}" tp="${f[4]}" pane="${TMUX_PANE:-}"
  # The process comes from CLAUDE_PID and the session from the hook input (code.claude.com/docs/en/env-vars):
  # CLAUDE_CODE_SESSION_ID is not compared, since after --continue or --resume without an id it may hold the startup id.
  # lane_session later proves the sessions file names this session.
  if ! [[ "$cpid" =~ ^[1-9][0-9]*$ ]]; then
    notice "CLAUDE_PID is '${cpid}' in the hook environment, not a process id (Claude Code 2.1.214 or later sets it): this session was not registered"
    hook_emit
    return 0
  fi
  [[ -n "${CLAUDE_PLUGIN_ROOT:-}" ]] && refresh_statusline_link "$CLAUDE_PLUGIN_ROOT"
  rc=0
  mutex_take 5 || rc=$?
  ((rc == 0)) || { notice "$(mutex_refusal "$rc"): not registered this time"; hook_emit; return 0; }
  record_config "$cwd"
  if [[ -z "$lane" ]]; then
    notice "no session_title in the hook input: start every session as 'claude --name <lane>' so it can be a lane"
    hook_emit
    return 0
  fi
  if ! valid_lane "$lane"; then
    notice "lane name '$lane' is not usable: use letters, digits, dot, dash and underscore (rename with /rename)"
    hook_emit
    return 0
  fi
  [[ -z "$pane" ]] && notice "TMUX_PANE is not set: lane '$lane' is registered without a pane, so 'lanes clear' cannot reach it; run it inside tmux"
  server=""
  [[ -n "$pane" ]] && server="$(caller_server)"
  [[ -n "$pane" && -z "$server" ]] && notice "TMUX is '${TMUX:-}', not tmux's '<socket>,<server pid>,<session>': lane '$lane' is registered without its tmux server, so its pane is never matched to it; start it from a tmux pane"
  existing=""
  if existing="$(reg_read "$lane")"; then
    :
  elif [[ $? -eq 2 ]]; then
    notice "registry entry for '$lane' was corrupt and has been replaced"
    existing=""
  fi
  role="lane" old_sid=""
  if [[ -n "$existing" ]]; then
    jq_fields 2 '(.session_id // ""), (.role // "lane")' "$existing" ||
      { notice "the registry entry for '$lane' could not be read: this session was not registered"; hook_emit; return 0; }
    old_sid="${FIELDS[0]}" role="${FIELDS[1]}"
    # Also for the same session id: a second process resuming the session (no --fork-session) is another process.
    held="$(name_holder "$lane" "$existing" "$cpid")" ||
      held="lane name '$lane' could not be checked against its registered session (check failed: ${held:-name_holder}): this session was not registered; run 'lanes status', then restart this session"
    if [[ -n "$held" ]]; then
      notice "$held"
      hook_emit
      return 0
    fi
  fi
  case "${LANES_ROLE:-}" in lead | lane) role="$LANES_ROLE" ;; esac
  fresh=1
  [[ -n "$existing" && "$old_sid" == "$sid" ]] && fresh=0
  # Another process took the name (the registered one proven gone, or none recorded): its handshake belongs to a
  # session that no longer runs, so this one starts with none.
  taken=0
  [[ -n "$existing" && "$(jq -r '.claude_pid // "" | tostring' <<<"$existing")" != "$cpid" ]] && taken=1
  # Beside the pane id: the caller's tmux server (caller_server; the pane id is unique only within it) and the pane's
  # pid (identity_problem), Claude Code's own pid and start time (lane_session, which proves a reused pid by it), and
  # its config dir, where its sessions file is (null: ~/.claude).
  ids="$( [[ -n "$pane" ]] && pane_identity "$pane" || true)"
  proc_start_get "$cpid" || true
  write_atomic "$(reg_file "$lane")" "$(jq -nc --argjson old "${existing:-null}" --arg lane "$lane" --arg sid "$sid" \
    --arg role "$role" --arg pane "$pane" --arg cwd "$cwd" --arg now "$(iso_now)" --argjson fresh "$fresh" --arg ids "$ids" \
    --arg server "$server" --argjson cpid "$cpid" --arg cst "$PS_VALUE" --arg ccd "${CLAUDE_CONFIG_DIR:-}" '
    ($ids | split(" ") | map(tonumber? // null)) as $id
    | {lane: $lane, session_id: $sid, role: $role, tmux_pane: (if $pane == "" then null else $pane end),
     tmux_pid: ($server | tonumber? // null), pane_pid: $id[1], claude_pid: $cpid,
     claude_start: (if $cst == "" then null else $cst end),
     claude_config_dir: (if $ccd == "" then null else $ccd end),
     cwd: $cwd,
     used_pct: (if $fresh == 1 then null else $old.used_pct end),
     clear_ready: (if $fresh == 1 then false else ($old.clear_ready // false) end), updated_at: $now}')"
  release_pane "$lane" "$server" "$pane"
  valid_sid "$sid" && write_atomic "$DATA/sessions/$sid" "$lane"
  gc_sessions
  if ((fresh)); then
    state_update "$lane" '(if $taken == 1 then del(.handshake) else . end)
      | (if (.handshake.state // "") == "sending" and .handshake.session_id != $sid and $src == "clear"
       then .handshake.state = "cleared" | .handshake.cleared_at = $now | .handshake.cleared_session = $sid else . end)
      | .session_id = $sid | .prompts = 0 | .last_command = null | .pct_at = null' --arg sid "$sid" --arg src "$src" \
      --argjson now "$(now)" --argjson taken "$taken"
  fi
  # How this session began (startup, resume, clear, compact, fork), so lanes clear tells a /clear from a restart.
  state_update "$lane" '.transcript = (if $tp == "" then null else $tp end) | .start_source = $src' --arg tp "$tp" --arg src "$src"
  # After the /clear lanes typed (the record it moved to cleared just now, for this session) RESUME is read from the
  # work tree clear-ready proved, when it is in the lane's project; after any other /clear, from the session's cwd.
  wt="$(state_read "$lane" | jq -r --arg sid "$sid" --argjson fresh "$fresh" '.handshake // {}
    | if $fresh == 1 and .state == "cleared" and .cleared_session == $sid then .worktree // "" else "" end')"
  [[ -z "$wt" || "$(project_of "$wt")" == "$(project_of "$cwd")" ]] || wt=""
  mutex_drop
  if [[ "$src" == clear ]]; then
    ctx="$(resume_context "$lane" "$role" "${wt:-$cwd}")"
  else
    ctx="lanes: $(who "$lane" "$role"); follow the ${role} skill."
  fi
  # The lead re-arms every watcher that is down; the model reads this, not the systemMessage.
  if [[ "$role" == lead ]]; then
    down="$(monitors_down "$(lane_project "$lane")")"
    [[ -z "$down" ]] || ctx+="${ctx:+$'\n\n'}lanes: watchers not running: $down. Start each from skills/lead/MONITORS.md (a running one refuses a second start)."
  fi
  hook_emit "$ctx"
}

# cmd_hook prompt|ask: UserPromptSubmit counts the session's prompts and keeps its last slash command, the proof that a
# typed /goal arrived and of new work since clear-ready; PreToolUse(AskUserQuestion) refuses in away mode.
# Activity is never recorded here, since it comes from the sessions file. Nothing is printed (a prompt's stdout
# reaches the model), and jq reads stdin once, since a prompt can be far larger than an argument may be.
cmd_hook() {
  local kind="${1:-}" lane proj rc f=()
  case "$kind" in ask | prompt) ;; *) usage ;; esac
  jq_fields 5 '
    if type == "object" then (.session_id // ""), (.session_title // ""), (.cwd // ""),
      ((.prompt // "") | if startswith("/") then .[0:200] else "" end),
      (.transcript_path // "" | tostring)
    else empty end' || { echo "lanes: hook input is not a JSON object" >&2; return 0; }
  f=("${FIELDS[@]}")
  if [[ "$kind" == ask ]]; then
    # Only a session registered in a project in away mode, its lead or a lane, is refused; any other session asks.
    lane="$(lane_for_session "${f[0]}" "${f[1]}")" || return 0
    proj="$(lane_project "$lane")"
    [[ -n "$proj" ]] && away_on "$proj" || return 0
    jq -nc --arg m "$(journal_root "${f[2]:-$(lane_cwd "$lane")}")/morning.md" '{hookSpecificOutput: {hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: ("lanes away mode is on: the human is away, so ask nothing now. Add the question to " + $m
        + " (one question, its facts and costs, your recommended option marked) and continue with other work. Only the human'"'"'s own message lifts away mode (lanes away off).")}}'
    return 0
  fi
  lane="$(lane_for_session "${f[0]}" "${f[1]}")" || return 0
  rc=0
  mutex_take 3 || rc=$?
  ((rc == 0)) || { echo "lanes: $(mutex_refusal "$rc"): prompt of '$lane' not recorded" >&2; return 0; }
  # Ownership is decided again under the mutex: a hook of an old session that waited here must not write over the
  # session that took the lane meanwhile.
  [[ "$(lane_for_session "${f[0]}" "${f[1]}")" == "$lane" ]] || { mutex_drop; return 0; }
  # The goal text is not kept: the RESUME Goal is the one source of the goal re-sent after /clear.
  state_update "$lane" '.session_id = $sid | .last_command = (if $cmd == "" then null else $cmd end)
    | .prompts = ((.prompts // 0) + 1) | (if $tp != "" then .transcript = $tp else . end)' \
    --arg sid "${f[0]}" --arg cmd "${f[3]}" --arg tp "${f[4]}"
  return 0
}

# ---- status line -------------------------------------------------------------------------------------------------

# cmd_statusline: record used_pct for the session that owns the lane, then print one line. Never fails, never waits
# long: Claude Code cancels a running status line when the next update arrives, and the write is a temp file + mv.
cmd_statusline() {
  local input lane sid pct line
  input="$(cat 2>/dev/null || true)"
  lane="$(jq -r '.session_name // ""' <<<"$input" 2>/dev/null || true)"
  sid="$(jq -r '.session_id // ""' <<<"$input" 2>/dev/null || true)"
  # After a /rename the session name is not the lane name: the session's own lane, when it has one, is used.
  lane="$(lane_for_session "$sid" "$lane" 2>/dev/null || echo "$lane")"
  pct="$(jq -r '.context_window.used_percentage // "null" | if type == "number" then floor else "null" end' <<<"$input" 2>/dev/null || echo null)"
  [[ "$pct" =~ ^[0-9]+$ ]] || pct=null
  if [[ -n "$lane" ]] && valid_lane "$lane"; then
    (
      trap on_exit EXIT # a subshell resets traps, and a cancelled status line must not leave a temp file
      trap 'exit 143' TERM INT
      mutex_take 1 || exit 0
      # Under the mutex: only the session that owns the lane now records its context %.
      [[ "$(reg_read "$lane" | jq -r .session_id 2>/dev/null)" == "$sid" ]] || exit 0
      reg_update "$lane" '.used_pct = $pct' --argjson pct "$pct"
      state_update "$lane" '.pct_at = $now' --argjson now "$(now)"
      mutex_drop
    ) 2>/dev/null || true
  fi
  line="lanes ${lane:-?} ctx ${pct/null/?}%"
  [[ "$pct" != null ]] && ((pct >= $(threshold "$(valid_lane "$lane" && lane_cwd "$lane")"))) && line+=" at threshold"
  printf '%s\n' "$line"
  return 0
}

# ---- status ------------------------------------------------------------------------------------------------------

# lane_view <lane>: one JSON object with everything status reports, the three-state context % included.
lane_view() {
  local lane="$1" e st pane alive=false n thr
  n="$(now)"
  if ! e="$(reg_read "$lane")"; then
    jq -nc --arg l "$lane" '{lane: $l, error: "corrupt registry entry"}'
    return
  fi
  st="$(state_read "$lane")"
  pane="$(jq -r '.tmux_pane // ""' <<<"$e")"
  pane_exists "$pane" && alive=true
  lane_activity "$lane"
  thr="$(threshold "$(jq -r '.cwd // ""' <<<"$e")")"
  jq -nc --argjson e "$e" --argjson s "$st" --argjson now "$n" --argjson thr "$thr" --argjson alive "$alive" \
    --arg act "$ACT" --arg detail "$ACT_DETAIL" --arg goal "$(goal_state "$(jq -r '.transcript // ""' <<<"$st")")" \
    --argjson stale "$PCT_STALE" --argjson rto "$REQUEST_TIMEOUT" '
    ($s.handshake // {}) as $h
    | {lane: $e.lane, role: $e.role, pane: $e.tmux_pane, pane_alive: $alive, used_pct: $e.used_pct, threshold: $thr,
       ctx: (if $e.used_pct == null then "unknown"
             elif ($s.pct_at // 0) < $now - $stale then "stale"
             else "fresh" end),
       at_threshold: ($e.used_pct != null and $e.used_pct >= $thr),
       activity: $act, activity_detail: (if $detail == "" then null else $detail end), goal: $goal,
       clear_ready: $e.clear_ready,
       handshake: (if $h.state == "requested" and ($h.requested_at // 0) < $now - $rto then "request-timed-out"
                   else ($h.state // "none") end)}'
}

# cmd_status: the lanes of the caller's project only (caller_project), so a lead never reads another project's lanes
# as its own. An entry that cannot be read names no project, so it shows as an error row in every project.
cmd_status() {
  local json=0 lane rows=() proj
  [[ "${1:-}" == "--json" ]] && json=1
  proj="$(caller_project)"
  while IFS= read -r lane; do
    reg_read "$lane" >/dev/null 2>&1 && [[ "$(lane_project "$lane")" != "$proj" ]] && continue
    rows+=("$(lane_view "$lane")")
  done < <(each_lane)
  if ((json)); then
    printf '%s\n' "${rows[@]+"${rows[@]}"}" | jq -s .
    return 0
  fi
  if ((${#rows[@]} == 0)); then
    echo "lanes: no lanes registered for $proj (start each session as 'claude --name <lane>' inside tmux, from this project)"
    return 0
  fi
  # Each lane's threshold is its own project's option, so it is not one header line: AT-THRESHOLD marks the row, and
  # --json gives the number.
  printf '%s\n' "${rows[@]}" | jq -r '
    if .error then "\(.lane)\tERROR: \(.error)"
    else [.lane, .role, (.pane // "no-pane") + (if .pane_alive then "" else "(gone)" end),
          (if .used_pct == null then "ctx unknown" else "ctx \(.used_pct)%" + (if .ctx == "stale" then " stale" else "" end) end)
            + (if .at_threshold then " AT-THRESHOLD" else "" end),
          .activity + (if .activity_detail then " (\(.activity_detail))" else "" end), "goal " + .goal,
          (if .clear_ready then "clear-ready" else "-" end), "handshake " + .handshake] | join("\t") end'
}

# ---- away mode, init ---------------------------------------------------------------------------------------------

# away_file <project>: the away record of one project, named by a checksum of its path, which can hold any character.
away_file() { printf '%s/away/%s.json' "$STATE" "$(hash_of "$1")"; }

# away_on <project>: away mode holds for that project; the record names its project, so a checksum collision is off.
away_on() { [[ "$(jq -r '.project // ""' "$(away_file "$1")" 2>/dev/null)" == "$1" ]]; }

# cmd_away: away mode is per project (caller_project), and the record names who set it (the caller's lane, from its
# pane) and when; only the human lifts it.
cmd_away() {
  local by proj
  proj="$(caller_project)"
  case "${1:-status}" in
    on)
      by="$(caller_lane)"
      write_atomic "$(away_file "$proj")" "$(jq -nc --arg p "$proj" --arg t "$(iso_now)" --arg by "${by:-outside a lane pane}" \
        '{away: true, project: $p, since: $t, set_by: $by}')"
      echo "away mode on for $proj: its lead and lanes are refused the ask tool; questions go to the morning list"
      ;;
    off) rm -f "$(away_file "$proj")" && echo "away mode off for $proj" ;;
    status)
      if away_on "$proj"; then
        jq -r '"away mode on since \(.since), set by \(.set_by // "an unknown caller"), for \(.project)"' "$(away_file "$proj")"
      else
        echo "away mode off for $proj"
      fi
      ;;
    *) usage ;;
  esac
}

cmd_init() {
  local claude_md="" root tpl dest f lane jd import created=() kept=() block cmd
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --claude-md) (($# >= 2)) || usage; claude_md="$2"; shift 2 ;;
      -*) usage ;;
      *) break ;;
    esac
  done
  root="$(plugin_root)"
  tpl="$root/templates/journal"
  [[ -d "$tpl" ]] || die "template folder $tpl is missing" "reinstall the lanes plugin"
  dest="$(journal_root "$PWD")"
  mkdir -p "$dest"
  for f in README.md RULES.md tracker.md morning.md; do
    if [[ -e "$dest/$f" ]]; then kept+=("$f"); else cp "$tpl/$f" "$dest/$f"; created+=("$f"); fi
  done
  for lane in "$@"; do
    valid_lane "$lane" || die "invalid lane '$lane'" "use letters, digits, dot, dash and underscore" 2
    for f in next "done"; do
      if [[ -e "$dest/$f-$lane.md" ]]; then kept+=("$f-$lane.md"); else
        sed "s/<lane>/$lane/g" "$tpl/$f-lane.md" >"$dest/$f-$lane.md"
        created+=("$f-$lane.md")
      fi
    done
  done
  echo "journal: $dest"
  ((${#created[@]})) && echo "  wrote: ${created[*]}"
  ((${#kept[@]})) && echo "  kept (already there): ${kept[*]}"

  refresh_statusline_link "$root"
  cmd="\"$DATA/lanes-statusline\""
  [[ -n "${LANES_DATA_DIR:-}" ]] && cmd="LANES_DATA_DIR=\"$LANES_DATA_DIR\" $cmd"
  block="$(jq -n --arg c "$cmd" '{statusLine: {type: "command", command: $c, refreshInterval: 30}}')"
  echo
  echo "status line: a plugin cannot set it, so add this to your settings.json (it records each lane's context %):"
  echo "$block"

  jd="$(journal_dir "$PWD")"
  import="@$jd/RULES.md"
  local top
  top="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"
  echo
  if [[ -f "$top/CLAUDE.md" ]] && grep -qxF "$import" "$top/CLAUDE.md"; then
    echo "CLAUDE.md already imports $import"
    return 0
  fi
  if [[ -z "$claude_md" && -t 0 ]]; then
    printf 'Add the line %s to %s/CLAUDE.md so every session loads the lanes rules? [y/N] ' "$import" "$top"
    read -r claude_md || claude_md=""
  fi
  case "$claude_md" in
    y | Y | yes)
      printf '\n%s\n' "$import" >>"$top/CLAUDE.md"
      echo "added $import to $top/CLAUDE.md"
      ;;
    n | N | no) echo "CLAUDE.md not changed" ;;
    "") echo "CLAUDE.md not changed: a plugin's own CLAUDE.md is not loaded, so the rules need '$import' in $top/CLAUDE.md; run 'lanes init --claude-md yes' to add it, or '--claude-md no' to skip" ;;
    *) die "--claude-md '$claude_md'" "answer yes or no" 2 ;;
  esac
}

# shellcheck source-path=SCRIPTDIR source=../lib/handshake.bash
source "$(plugin_root)/lib/handshake.bash"
# shellcheck source-path=SCRIPTDIR source=../lib/monitor.bash
source "$(plugin_root)/lib/monitor.bash"

# Sourced (tests feed real captures to screen_read, session_read and goal_state): define everything, run nothing.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0

case "${1:-}" in status | request | clear-ready | clear | goal) settings_check ;; esac
# The two commands that type into a pane (submit); nothing else sends a key.
case "${1:-}" in clear | goal) tmux_check ;; esac
case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  register) cmd_register ;;
  hook) shift; cmd_hook "$@" ;;
  statusline) cmd_statusline ;;
  status) shift; cmd_status "$@" ;;
  request) shift; cmd_request "$@" ;;
  clear-ready) shift; cmd_clear_ready "$@" ;;
  clear) shift; cmd_clear "$@" ;;
  goal) shift; cmd_goal "$@" ;;
  away) shift; cmd_away "$@" ;;
  journal-dir) journal_root "$PWD" ;;
  monitor-lock) shift; cmd_monitor_lock "$@" ;;
  monitor-diff) shift; cmd_monitor_diff "$@" ;;
  *) usage ;;
esac
